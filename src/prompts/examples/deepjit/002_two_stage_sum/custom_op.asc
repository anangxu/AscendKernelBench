// Two-stage fp32 sum.
// Stage 1 (partial_sum): every block reduces its contiguous chunk into one
// partial sum and writes it to the intermediate tensor.
// Stage 2 (finalize_sum): one block folds the partials into the result.
// The two entries live in separate compiled units, split by the
// ASCEND_KERNEL_SECTION marker; the text before the first marker is the
// shared preamble that both units include.
#include "kernel_operator.h"

constexpr uint32_t kTileElements = 2048;
constexpr uint32_t kLanes = 8;  // one 32-byte block of lane sums

struct BlockRange {
    uint32_t start;
    uint32_t length;
};

__aicore__ inline BlockRange block_range(uint32_t totalLength, uint32_t blockNum,
                                         uint32_t blockIdx)
{
    uint32_t base = totalLength / blockNum;
    uint32_t rem = totalLength % blockNum;
    BlockRange range;
    range.length = base + (blockIdx < rem ? 1 : 0);
    range.start = blockIdx * base + (blockIdx < rem ? blockIdx : rem);
    return range;
}

// Reduction with element-wise vector adds only.
// A halving tree keeps every view offset a multiple of eight floats (32
// bytes), and the last eight lane sums are folded through global memory.
__aicore__ inline void reduce_to_lanes(const AscendC::LocalTensor<float>& acc,
                                       uint32_t width)
{
    for (uint32_t half = width / 2; half >= 8; half /= 2) {
        AscendC::Add(acc, acc, acc[half], half);
    }
}

// Fold the eight lane sums that reached global memory.
__aicore__ inline float fold_lanes(__gm__ float* lanes)
{
    const float low = (lanes[0] + lanes[1]) + (lanes[2] + lanes[3]);
    const float high = (lanes[4] + lanes[5]) + (lanes[6] + lanes[7]);
    return low + high;
}

// ==================== ASCEND_KERNEL_SECTION ====================

class KernelPartial {
public:
    __aicore__ inline KernelPartial() {}

    __aicore__ inline void Init(__gm__ uint8_t* x, __gm__ uint8_t* lanes,
                                uint32_t totalLength)
    {
        uint32_t blockNum = (uint32_t)AscendC::GetBlockNum();
        uint32_t blockIdx = (uint32_t)AscendC::GetBlockIdx();
        BlockRange range = block_range(totalLength, blockNum, blockIdx);
        this->blockLength = range.length;
        xGm.SetGlobalBuffer((__gm__ float*)x + range.start, range.length);
        lanesGm.SetGlobalBuffer((__gm__ float*)lanes + blockIdx * kLanes, kLanes);
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
        AscendC::LocalTensor<float> xLocal = ubAllocator.Alloc<float>(kTileElements);
        AscendC::LocalTensor<float> accLocal = ubAllocator.Alloc<float>(kTileElements);

        AscendC::Duplicate(accLocal, 0.0f, kTileElements);
        AscendC::PipeBarrier<PIPE_ALL>();

        AscendC::DataCopyExtParams copyParams{1, 0, 0, 0, 0};
        AscendC::DataCopyPadExtParams<float> padParams{false, 0, 0, 0};
        uint32_t loopCount = (this->blockLength + kTileElements - 1) / kTileElements;
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
        for (uint32_t i = 0; i < loopCount; ++i) {
            uint32_t offset = i * kTileElements;
            uint32_t remaining = this->blockLength - offset;
            uint32_t len = remaining < kTileElements ? remaining : kTileElements;
            copyParams.blockLen = len * (uint32_t)sizeof(float);
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
            AscendC::DataCopyPad(xLocal, xGm[offset], copyParams, padParams);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
            AscendC::Add(accLocal, accLocal, xLocal, len);
            AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
        }
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
        AscendC::PipeBarrier<PIPE_ALL>();

        reduce_to_lanes(accLocal, kTileElements);
        AscendC::PipeBarrier<PIPE_ALL>();

        AscendC::DataCopyExtParams laneParams{
            1, kLanes * (uint32_t)sizeof(float), 0, 0, 0};
        AscendC::DataCopyPad(lanesGm, accLocal, laneParams);
        // The barrier is what makes the lane block visible to the scalar
        // reads below; the 1-argument DataCacheCleanAndInvalid overload does
        // not exist on this CANN, and the barrier alone is enough here.
        // Publish the lane block through MTE3; the second kernel folds it.
        AscendC::PipeBarrier<PIPE_ALL>();
    }

private:
    AscendC::GlobalTensor<float> xGm;
    AscendC::GlobalTensor<float> lanesGm;
    uint32_t blockLength;
};

__global__ __vector__ void partial_sum(__gm__ uint8_t* x, __gm__ uint8_t* lanes,
                                       uint32_t totalLength)
{
    AscendC::InitSocState();
    KernelPartial op;
    op.Init(x, lanes, totalLength);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ==================== ASCEND_KERNEL_SECTION ====================

class KernelFinalize {
public:
    __aicore__ inline KernelFinalize() {}

    __aicore__ inline void Init(__gm__ uint8_t* lanes, __gm__ uint8_t* out,
                                uint32_t laneCount)
    {
        this->laneCount = laneCount;
        this->lanes = (__gm__ float*)lanes;
        this->out = (__gm__ float*)out;
    }

    __aicore__ inline void Process()
    {
        // Eight lane sums per block, so a short scalar loop folds them.
        float total = 0.0f;
        for (uint32_t i = 0; i < this->laneCount; ++i) {
            total += this->lanes[i];
        }
        this->out[0] = total;
    }

private:
    __gm__ float* lanes;
    __gm__ float* out;
    uint32_t laneCount;
};

__global__ __vector__ void finalize_sum(__gm__ uint8_t* lanes, __gm__ uint8_t* out,
                                        uint32_t laneCount)
{
    AscendC::InitSocState();
    KernelFinalize op;
    op.Init(lanes, out, laneCount);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ==================== ASCEND_HOST_SECTION ====================

#include <torch/library.h>
#include <ATen/ATen.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"

namespace custom_op_ns {

// The host section is a separate translation unit from the device units, so
// the tile size and the lane count are repeated here on purpose.
constexpr uint32_t kTileElements = 2048;
constexpr uint32_t kLanes = 8;

at::Tensor run(const at::Tensor& x)
{
    auto aclStream = c10_npu::getCurrentNPUStream().stream(false);
    at::Tensor out = at::empty({}, x.options());
    uint32_t totalLength = 1;
    for (uint32_t size : x.sizes()) {
        totalLength *= size;
    }
    constexpr uint32_t kMaxBlocks = 40;  // vector cores on this Ascend 910B4
    constexpr uint32_t kMinPerCore = kTileElements;
    uint32_t numBlocks = kMaxBlocks;
    if (totalLength < numBlocks * kMinPerCore) {
        numBlocks = (totalLength + kMinPerCore - 1) / kMinPerCore;
    }
    if (numBlocks == 0) {
        numBlocks = 1;
    }
    // One 32-byte lane block per block, sized by the real block count and
    // held until both launches are enqueued. Both kernels run on the current
    // stream, so the caching allocator cannot reuse it before the second
    // kernel reads it.
    at::Tensor lanes = at::empty({(int64_t)numBlocks * kLanes}, x.options());
    partial_sum_launch(numBlocks, (void*)aclStream,
                       (uint8_t*)(x.mutable_data_ptr()),
                       (uint8_t*)(lanes.mutable_data_ptr()), totalLength);
    finalize_sum_launch(1, (void*)aclStream,
                        (uint8_t*)(lanes.mutable_data_ptr()),
                        (uint8_t*)(out.mutable_data_ptr()), numBlocks * kLanes);
    return out;
}
} // namespace custom_op_ns

TORCH_LIBRARY(custom_op, m) { m.def("run(Tensor x) -> Tensor"); }

TORCH_LIBRARY_IMPL(custom_op, PrivateUse1, m)
{
    m.impl("run", TORCH_FN(custom_op_ns::run));
}
