// Element-wise fp32 add: C = A + B.
// Process-local shared library: device kernels above the
// ASCEND_HOST_SECTION marker, torch glue below; the evaluator compiles the
// sections as separate units and loads libcustom_op.so with
// torch.ops.load_library.
#include "kernel_operator.h"

class KernelAdd {
public:
    __aicore__ inline KernelAdd() {}

    __aicore__ inline void Init(__gm__ uint8_t* x, __gm__ uint8_t* y, __gm__ uint8_t* z,
                                uint32_t totalLength, uint32_t tileLength)
    {
        // Partition elements across cores; the first `rem` cores take one extra.
        uint32_t blockNum = AscendC::GetBlockNum();
        uint32_t blockIdx = AscendC::GetBlockIdx();
        uint32_t base = totalLength / blockNum;
        uint32_t rem = totalLength % blockNum;
        this->blockLength = base + (blockIdx < rem ? 1 : 0);
        this->start = blockIdx * base + (blockIdx < rem ? blockIdx : rem);
        this->tileLength = tileLength;
        xGm.SetGlobalBuffer((__gm__ float*)x + this->start, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ float*)y + this->start, this->blockLength);
        zGm.SetGlobalBuffer((__gm__ float*)z + this->start, this->blockLength);
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
        AscendC::LocalTensor<float> xLocal = ubAllocator.Alloc<float>(this->tileLength);
        AscendC::LocalTensor<float> yLocal = ubAllocator.Alloc<float>(this->tileLength);
        AscendC::LocalTensor<float> zLocal = ubAllocator.Alloc<float>(this->tileLength);

        uint32_t loopCount = (this->blockLength + this->tileLength - 1) / this->tileLength;
        // Single-buffered pipeline: pre-set the two consumer flags so the first
        // iteration's waits pass immediately.
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        for (uint32_t i = 0; i < loopCount; i++) {
            uint32_t offset = i * this->tileLength;
            uint32_t remaining = this->blockLength - offset;
            uint32_t len = remaining < this->tileLength ? remaining : this->tileLength;
            // DataCopyPad handles the tail tile whose length is not 32B-aligned.
            AscendC::DataCopyExtParams copyParams{1, len * (uint32_t)sizeof(float), 0, 0, 0};
            AscendC::DataCopyPadExtParams<float> padParams{false, 0, 0, 0};

            AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
            AscendC::DataCopyPad(xLocal, xGm[offset], copyParams, padParams);
            AscendC::DataCopyPad(yLocal, yGm[offset], copyParams, padParams);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

            AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
            AscendC::Add(zLocal, xLocal, yLocal, len);
            AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
            // The copy-out (MTE3 pipe) must wait for the compute (V pipe):
            // set V_MTE3 after the math and wait for it before DataCopyPad.
            AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

            AscendC::DataCopyPad(zGm[offset], zLocal, copyParams);
            AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        }
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
    }

private:
    AscendC::GlobalTensor<float> xGm;
    AscendC::GlobalTensor<float> yGm;
    AscendC::GlobalTensor<float> zGm;
    uint32_t start;
    uint32_t blockLength;
    uint32_t tileLength;
};

__global__ __vector__ void add_custom(__gm__ uint8_t* x, __gm__ uint8_t* y, __gm__ uint8_t* z,
                                      uint32_t totalLength, uint32_t tileLength)
{
    AscendC::InitSocState();
    KernelAdd op;
    op.Init(x, y, z, totalLength, tileLength);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ==================== ASCEND_HOST_SECTION ====================

#include <torch/library.h>
#include <ATen/ATen.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"

namespace custom_op_ns {
at::Tensor run(const at::Tensor& x, const at::Tensor& y)
{
    auto aclStream = c10_npu::getCurrentNPUStream().stream(false);
    at::Tensor z = at::empty_like(x);
    uint32_t totalLength = 1;
    for (uint32_t size : x.sizes()) {
        totalLength *= size;
    }
    uint32_t tileLength = 2048;  // 8KB per buffer per tile, well under the UB budget
    uint32_t numBlocks = 48;     // vector cores on Ascend 910B2
    uint32_t minPerCore = tileLength;
    if (totalLength < numBlocks * minPerCore) {
        numBlocks = (totalLength + minPerCore - 1) / minPerCore;
    }
    // The build generates add_custom_launch from the kernel signature
    // above; pass the kernel arguments in order after the stream.
    add_custom_launch(numBlocks, (void*)aclStream,
                      (uint8_t*)(x.mutable_data_ptr()),
                      (uint8_t*)(y.mutable_data_ptr()),
                      (uint8_t*)(z.mutable_data_ptr()), totalLength,
                      tileLength);
    return z;
}
} // namespace custom_op_ns

TORCH_LIBRARY(custom_op, m) { m.def("run(Tensor x, Tensor y) -> Tensor"); }

TORCH_LIBRARY_IMPL(custom_op, PrivateUse1, m)
{
    m.impl("run", TORCH_FN(custom_op_ns::run));
}
