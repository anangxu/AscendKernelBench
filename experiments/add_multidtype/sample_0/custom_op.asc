// Multi-dtype elementwise add for the case-adapter acceptance fixture.
// One candidate handles fp32, fp16, and bf16; the host dispatches on the input
// dtype, and the case adapter supplies the shape and dtype. Hand-written.
#include "kernel_operator.h"

template <typename T>
class KernelAdd {
public:
    __aicore__ inline KernelAdd() {}

    __aicore__ inline void Init(__gm__ uint8_t* x, __gm__ uint8_t* y, __gm__ uint8_t* z,
                                uint32_t total, uint32_t tile)
    {
        uint32_t blockNum = AscendC::GetBlockNum();
        uint32_t blockIdx = AscendC::GetBlockIdx();
        uint32_t base = total / blockNum;
        uint32_t rem = total % blockNum;
        this->blockLength = base + (blockIdx < rem ? 1 : 0);
        this->start = blockIdx * base + (blockIdx < rem ? blockIdx : rem);
        this->tile = tile;
        xGm.SetGlobalBuffer((__gm__ T*)x + this->start, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ T*)y + this->start, this->blockLength);
        zGm.SetGlobalBuffer((__gm__ T*)z + this->start, this->blockLength);
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ub;
        AscendC::LocalTensor<T> xl = ub.Alloc<T>(this->tile);
        AscendC::LocalTensor<T> yl = ub.Alloc<T>(this->tile);
        AscendC::LocalTensor<T> zl = ub.Alloc<T>(this->tile);
        uint32_t loops = (this->blockLength + this->tile - 1) / this->tile;
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        for (uint32_t i = 0; i < loops; i++) {
            uint32_t off = i * this->tile;
            uint32_t left = this->blockLength - off;
            uint32_t len = left < this->tile ? left : this->tile;
            AscendC::DataCopyExtParams cp{1, len * (uint32_t)sizeof(T), 0, 0, 0};
            AscendC::DataCopyPadExtParams<T> pad{false, 0, 0, 0};
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
            AscendC::DataCopyPad(xl, xGm[off], cp, pad);
            AscendC::DataCopyPad(yl, yGm[off], cp, pad);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
            AscendC::Add(zl, xl, yl, len);
            AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
            AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
            AscendC::DataCopyPad(zGm[off], zl, cp);
            AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        }
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
    }

private:
    AscendC::GlobalTensor<T> xGm, yGm, zGm;
    uint32_t start, blockLength, tile;
};

#define DEFINE_ADD(NAME, TYPE)                                                        \
__global__ __vector__ void NAME(__gm__ uint8_t* x, __gm__ uint8_t* y,                 \
                                __gm__ uint8_t* z, uint32_t total, uint32_t tile)     \
{                                                                                     \
    AscendC::InitSocState();                                                          \
    KernelAdd<TYPE> op;                                                               \
    op.Init(x, y, z, total, tile);                                                    \
    op.Process();                                                                     \
    AscendC::PipeBarrier<PIPE_ALL>();                                                 \
}

DEFINE_ADD(add_f32, float)
DEFINE_ADD(add_f16, half)
DEFINE_ADD(add_bf16, bfloat16_t)

// ==================== ASCEND_HOST_SECTION ====================

#include <torch/library.h>
#include <ATen/ATen.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"

namespace custom_op_ns {
at::Tensor run(const at::Tensor& x, const at::Tensor& y)
{
    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    at::Tensor z = at::empty_like(x);
    uint32_t total = 1;
    for (uint32_t size : x.sizes()) {
        total *= size;
    }
    uint32_t tile = 2048;
    uint32_t numBlocks = 40;
    if (total < tile) {
        numBlocks = 1;
    }
    if (x.scalar_type() == at::kFloat) {
        add_f32_launch(numBlocks, (void*)stream, (uint8_t*)x.mutable_data_ptr(),
                       (uint8_t*)y.mutable_data_ptr(), (uint8_t*)z.mutable_data_ptr(), total, tile);
    } else if (x.scalar_type() == at::kHalf) {
        add_f16_launch(numBlocks, (void*)stream, (uint8_t*)x.mutable_data_ptr(),
                       (uint8_t*)y.mutable_data_ptr(), (uint8_t*)z.mutable_data_ptr(), total, tile);
    } else if (x.scalar_type() == at::kBFloat16) {
        add_bf16_launch(numBlocks, (void*)stream, (uint8_t*)x.mutable_data_ptr(),
                        (uint8_t*)y.mutable_data_ptr(), (uint8_t*)z.mutable_data_ptr(), total, tile);
    } else {
        TORCH_CHECK(false, "unsupported dtype for the add fixture");
    }
    return z;
}
} // namespace custom_op_ns

TORCH_LIBRARY(custom_op, m) { m.def("run(Tensor x, Tensor y) -> Tensor"); }

TORCH_LIBRARY_IMPL(custom_op, PrivateUse1, m)
{
    m.impl("run", TORCH_FN(custom_op_ns::run));
}
