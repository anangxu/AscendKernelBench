// framework_selftest fixture: official SwiGlu case 15, fp32 [512,4096], dim=-1.
// One input, split the last dim in half, y = silu(x0) * x1. Hand-written only
// to prove the AKB execution path; it is not a model answer.
#include "kernel_operator.h"

class KernelSwiGlu {
public:
    __aicore__ inline KernelSwiGlu() {}

    __aicore__ inline void Init(__gm__ uint8_t* x, __gm__ uint8_t* y,
                                uint32_t rows, uint32_t half)
    {
        this->rows = rows; this->half = half;
        this->blockNum = AscendC::GetBlockNum();
        this->blockIdx = AscendC::GetBlockIdx();
        xGm.SetGlobalBuffer((__gm__ float*)x, (uint64_t)rows * 2 * half);
        yGm.SetGlobalBuffer((__gm__ float*)y, (uint64_t)rows * half);
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ub;
        AscendC::LocalTensor<float> a = ub.Alloc<float>(this->half);
        AscendC::LocalTensor<float> b = ub.Alloc<float>(this->half);
        AscendC::LocalTensor<float> neg = ub.Alloc<float>(this->half);
        AscendC::LocalTensor<float> ex = ub.Alloc<float>(this->half);
        AscendC::LocalTensor<float> sig = ub.Alloc<float>(this->half);
        AscendC::LocalTensor<float> out = ub.Alloc<float>(this->half);
        AscendC::LocalTensor<float> one = ub.Alloc<float>(this->half);
        AscendC::DataCopyExtParams cp{1, this->half * (uint32_t)sizeof(float), 0, 0, 0};
        AscendC::DataCopyPadExtParams<float> pad{false, 0, 0, 0};
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        for (uint32_t row = this->blockIdx; row < this->rows; row += this->blockNum) {
            uint64_t base = (uint64_t)row * 2 * this->half;
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
            AscendC::DataCopyPad(a, xGm[base], cp, pad);
            AscendC::DataCopyPad(b, xGm[base + this->half], cp, pad);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
            AscendC::Muls(neg, a, -1.0f, this->half);
            AscendC::Exp(ex, neg, this->half);
            AscendC::Adds(ex, ex, 1.0f, this->half);
            AscendC::Duplicate(one, 1.0f, this->half);
            AscendC::Div(sig, one, ex, this->half);
            AscendC::Mul(out, a, sig, this->half);
            AscendC::Mul(out, out, b, this->half);
            AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
            AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
            AscendC::DataCopyPad(yGm[(uint64_t)row * this->half], out, cp);
            AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        }
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
    }

private:
    AscendC::GlobalTensor<float> xGm, yGm;
    uint32_t rows, half, blockNum, blockIdx;
};

__global__ __vector__ void swiglu_selftest(__gm__ uint8_t* x, __gm__ uint8_t* y,
                                           uint32_t rows, uint32_t half)
{
    AscendC::InitSocState();
    KernelSwiGlu op;
    op.Init(x, y, rows, half);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ==================== ASCEND_HOST_SECTION ====================

#include <torch/library.h>
#include <ATen/ATen.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"

namespace custom_op_ns {
at::Tensor run(const at::Tensor& x)
{
    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    uint32_t half = (uint32_t)(x.size(-1) / 2);
    uint32_t rows = (uint32_t)(x.numel() / (2 * half));
    at::Tensor y = at::empty({x.size(0), (int64_t)half}, x.options());
    uint32_t blocks = 40;
    if (rows < blocks) { blocks = rows; }
    swiglu_selftest_launch(blocks, (void*)stream, (uint8_t*)x.mutable_data_ptr(),
                           (uint8_t*)y.mutable_data_ptr(), rows, half);
    return y;
}
} // namespace custom_op_ns

TORCH_LIBRARY(custom_op, m) { m.def("run(Tensor x) -> Tensor"); }
TORCH_LIBRARY_IMPL(custom_op, PrivateUse1, m) { m.impl("run", TORCH_FN(custom_op_ns::run)); }
