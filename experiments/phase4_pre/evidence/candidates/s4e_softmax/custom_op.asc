#include "kernel_operator.h"

using namespace AscendC;

namespace smx {

constexpr uint32_t BUF_ELEMS = 3072;   // fp32 elements per UB buffer (12 KB)
constexpr uint32_t ALIGN_E   = 8;      // 32B / sizeof(float)

__aicore__ inline uint32_t MinU(uint32_t a, uint32_t b) { return a < b ? a : b; }

__aicore__ inline void SyncVS()
{
    SetFlag<HardEvent::V_S>(EVENT_ID0);
    WaitFlag<HardEvent::V_S>(EVENT_ID0);
}

template <typename T>
struct Cvt {
    static __aicore__ inline void ToF(LocalTensor<float> dst, LocalTensor<T> src, uint32_t n)
    {
        Cast<float, T>(dst, src, RoundMode::CAST_NONE, n);
    }
    static __aicore__ inline void FromF(LocalTensor<T> dst, LocalTensor<float> src, uint32_t n)
    {
        Cast<T, float>(dst, src, RoundMode::CAST_RINT, n);
    }
};

template <>
struct Cvt<float> {
    static __aicore__ inline void ToF(LocalTensor<float> dst, LocalTensor<float> src, uint32_t n)
    {
        Adds(dst, src, 0.0f, n);
    }
    static __aicore__ inline void FromF(LocalTensor<float> dst, LocalTensor<float> src, uint32_t n)
    {
        Adds(dst, src, 0.0f, n);
    }
};

// Reduce max of buf[0..L) into a scalar. Destroys the first ALIGN_E elements.
__aicore__ inline float ReduceMaxFP(LocalTensor<float> buf, uint32_t L)
{
    uint32_t nb = L / ALIGN_E;
    while (nb > 1u) {
        uint32_t h = nb >> 1;
        Max(buf, buf, buf[h * ALIGN_E], h * ALIGN_E);
        if (nb & 1u) {
            Max(buf, buf, buf[2u * h * ALIGN_E], ALIGN_E);
        }
        nb = h;
    }
    SyncVS();
    uint32_t fullEnd = nb * ALIGN_E;
    if (fullEnd == 0u) fullEnd = 1u;
    float m = buf.GetValue(0);
    for (uint32_t i = 1; i < fullEnd; ++i) {
        float v = buf.GetValue(i);
        if (v > m) m = v;
    }
    for (uint32_t i = fullEnd; i < L; ++i) {
        float v = buf.GetValue(i);
        if (v > m) m = v;
    }
    return m;
}

// Reduce sum of buf[0..L) into a scalar. Destroys the first ALIGN_E elements.
__aicore__ inline float ReduceSumFP(LocalTensor<float> buf, uint32_t L)
{
    uint32_t nb = L / ALIGN_E;
    while (nb > 1u) {
        uint32_t h = nb >> 1;
        Add(buf, buf, buf[h * ALIGN_E], h * ALIGN_E);
        if (nb & 1u) {
            Add(buf, buf, buf[2u * h * ALIGN_E], ALIGN_E);
        }
        nb = h;
    }
    SyncVS();
    uint32_t fullEnd = nb * ALIGN_E;
    if (fullEnd == 0u) fullEnd = 1u;
    float s = buf.GetValue(0);
    for (uint32_t i = 1; i < fullEnd; ++i) {
        s += buf.GetValue(i);
    }
    for (uint32_t i = fullEnd; i < L; ++i) {
        s += buf.GetValue(i);
    }
    return s;
}

template <typename T>
class SoftmaxKernel {
public:
    __aicore__ inline SoftmaxKernel() {}

    __aicore__ inline void Init(__gm__ uint8_t* x, __gm__ uint8_t* y,
                                uint32_t outerIn, uint32_t nIn, uint32_t innerIn)
    {
        outer = outerIn;
        n = nIn;
        inner = innerIn;
        uint32_t total = outerIn * nIn * innerIn;
        xGm.SetGlobalBuffer((__gm__ T*)x, total);
        yGm.SetGlobalBuffer((__gm__ T*)y, total);
    }

    __aicore__ inline void Process()
    {
        LocalMemAllocator<Hardware::UB> ub;
        bufF = ub.Alloc<float>(BUF_ELEMS);
        auxF = ub.Alloc<float>(BUF_ELEMS);
        sumF = ub.Alloc<float>(BUF_ELEMS);
        rawT = ub.Alloc<T>(BUF_ELEMS);

        if (inner == 1u) {
            RowsPath();
        } else {
            ColsPath();
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t off, uint32_t len)
    {
        DataCopyExtParams p;
        p.blockCount = 1;
        p.blockLen = (uint32_t)(len * sizeof(T));
        p.srcStride = 0;
        p.dstStride = 0;
        DataCopyPadExtParams<T> pp;
        pp.isPad = false;
        pp.leftPadding = 0;
        pp.rightPadding = 0;
        pp.paddingValue = (T)0;
        DataCopyPad(rawT, xGm[off], p, pp);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Cvt<T>::ToF(bufF, rawT, len);
    }

    __aicore__ inline void CopyOut(uint32_t off, uint32_t len)
    {
        Cvt<T>::FromF(rawT, bufF, len);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyExtParams p;
        p.blockCount = 1;
        p.blockLen = (uint32_t)(len * sizeof(T));
        p.srcStride = 0;
        p.dstStride = 0;
        DataCopyPad(yGm[off], rawT, p);
        SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
    }

    // ---------------- softmax over the last dim (inner == 1) ----------------
    __aicore__ inline void RowsPath()
    {
        uint32_t bn = (uint32_t)GetBlockNum();
        uint32_t bi = (uint32_t)GetBlockIdx();
        for (uint32_t r = bi; r < outer; r += bn) {
            DoRow(r);
        }
    }

    __aicore__ inline void DoRow(uint32_t r)
    {
        uint32_t base = r * n;
        uint32_t tiles = (n + BUF_ELEMS - 1u) / BUF_ELEMS;
        if (tiles <= 1u) {
            CopyIn(base, n);
            Adds(auxF, bufF, 0.0f, n);
            float m = ReduceMaxFP(auxF, n);
            Adds(bufF, bufF, -m, n);
            Exp(bufF, bufF, n);
            Adds(auxF, bufF, 0.0f, n);
            float s = ReduceSumFP(auxF, n);
            Muls(bufF, bufF, 1.0f / s, n);
            CopyOut(base, n);
            return;
        }
        float m = -3.4e38f;
        for (uint32_t t = 0; t < tiles; ++t) {
            uint32_t off = t * BUF_ELEMS;
            uint32_t len = MinU(BUF_ELEMS, n - off);
            CopyIn(base + off, len);
            Adds(auxF, bufF, 0.0f, len);
            float tm = ReduceMaxFP(auxF, len);
            if (tm > m) m = tm;
        }
        float s = 0.0f;
        for (uint32_t t = 0; t < tiles; ++t) {
            uint32_t off = t * BUF_ELEMS;
            uint32_t len = MinU(BUF_ELEMS, n - off);
            CopyIn(base + off, len);
            Adds(bufF, bufF, -m, len);
            Exp(bufF, bufF, len);
            Adds(auxF, bufF, 0.0f, len);
            s += ReduceSumFP(auxF, len);
        }
        float inv = 1.0f / s;
        for (uint32_t t = 0; t < tiles; ++t) {
            uint32_t off = t * BUF_ELEMS;
            uint32_t len = MinU(BUF_ELEMS, n - off);
            CopyIn(base + off, len);
            Adds(bufF, bufF, -m, len);
            Exp(bufF, bufF, len);
            Muls(bufF, bufF, inv, len);
            CopyOut(base + off, len);
        }
    }

    // ---------------- softmax over an inner dim (inner > 1) ----------------
    __aicore__ inline void ColsPath()
    {
        uint32_t ctiles = (inner + BUF_ELEMS - 1u) / BUF_ELEMS;
        uint32_t total = outer * ctiles;
        uint32_t bn = (uint32_t)GetBlockNum();
        uint32_t bi = (uint32_t)GetBlockIdx();
        for (uint32_t w = bi; w < total; w += bn) {
            uint32_t o = w / ctiles;
            uint32_t ct = w - o * ctiles;
            uint32_t c0 = ct * BUF_ELEMS;
            uint32_t C = MinU(BUF_ELEMS, inner - c0);
            DoCols(o, c0, C);
        }
    }

    __aicore__ inline void DoCols(uint32_t o, uint32_t c0, uint32_t C)
    {
        uint32_t base = o * n * inner + c0;

        // pass 1 : per column max in auxF
        CopyIn(base, C);
        Adds(auxF, bufF, 0.0f, C);
        for (uint32_t k = 1; k < n; ++k) {
            CopyIn(base + k * inner, C);
            Max(auxF, auxF, bufF, C);
        }

        // pass 2 : per column sum of exp in sumF
        Muls(sumF, bufF, 0.0f, C);
        for (uint32_t k = 0; k < n; ++k) {
            CopyIn(base + k * inner, C);
            Sub(bufF, bufF, auxF, C);
            Exp(bufF, bufF, C);
            Add(sumF, sumF, bufF, C);
        }

        // pass 3 : normalize and store
        for (uint32_t k = 0; k < n; ++k) {
            CopyIn(base + k * inner, C);
            Sub(bufF, bufF, auxF, C);
            Exp(bufF, bufF, C);
            Div(bufF, bufF, sumF, C);
            CopyOut(base + k * inner, C);
        }
    }

    GlobalTensor<T> xGm;
    GlobalTensor<T> yGm;
    LocalTensor<float> bufF;
    LocalTensor<float> auxF;
    LocalTensor<float> sumF;
    LocalTensor<T> rawT;
    uint32_t outer = 1;
    uint32_t n = 1;
    uint32_t inner = 1;
};

} // namespace smx

__global__ __vector__ void softmax_entry(
    __gm__ uint8_t* x,
    __gm__ uint8_t* y,
    uint32_t outer,
    uint32_t n,
    uint32_t inner,
    int32_t dtype)
{
    AscendC::InitSocState();
    if (dtype == 0) {
        smx::SoftmaxKernel<float> op;
        op.Init(x, y, outer, n, inner);
        op.Process();
    } else if (dtype == 1) {
        smx::SoftmaxKernel<half> op;
        op.Init(x, y, outer, n, inner);
        op.Process();
    } else {
        smx::SoftmaxKernel<bfloat16_t> op;
        op.Init(x, y, outer, n, inner);
        op.Process();
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ==================== ASCEND_HOST_SECTION ====================

#include <torch/library.h>
#include <ATen/ATen.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"

at::Tensor softmax_run(const at::Tensor& x, int64_t dim)
{
    at::Tensor xc = x.contiguous();
    int64_t rank = xc.dim();
    if (rank <= 0) {
        return at::empty_like(xc);
    }
    if (dim < 0) {
        dim += rank;
    }
    TORCH_CHECK(dim >= 0 && dim < rank, "softmax: dim out of range");

    int64_t outer = 1;
    int64_t inner = 1;
    for (int64_t i = 0; i < dim; ++i) outer *= xc.size(i);
    int64_t n = xc.size(dim);
    for (int64_t i = dim + 1; i < rank; ++i) inner *= xc.size(i);

    at::Tensor y = at::empty_like(xc);
    if (xc.numel() == 0 || n == 0) {
        return y;
    }

    int32_t dt = 0;
    auto st = xc.scalar_type();
    if (st == at::kFloat) {
        dt = 0;
    } else if (st == at::kHalf) {
        dt = 1;
    } else if (st == at::kBFloat16) {
        dt = 2;
    } else {
        TORCH_CHECK(false, "softmax: unsupported dtype");
    }

    auto aclStream = c10_npu::getCurrentNPUStream().stream(false);
    int numBlocks = 40;

    softmax_entry_launch(numBlocks, (void*)aclStream,
                         (uint8_t*)xc.data_ptr(),
                         (uint8_t*)y.data_ptr(),
                         (uint32_t)outer,
                         (uint32_t)n,
                         (uint32_t)inner,
                         dt);
    return y;
}

TORCH_LIBRARY(custom_op, m) {
    m.def("run(Tensor x, int dim) -> Tensor", &softmax_run);
}

TORCH_LIBRARY_IMPL(custom_op, PrivateUse1, m) {
    m.impl("run", &softmax_run);
}
