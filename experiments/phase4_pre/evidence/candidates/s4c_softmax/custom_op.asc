#include "kernel_operator.h"

using namespace AscendC;

constexpr uint32_t TILE = 4096;

template<typename T>
__aicore__ inline void CopyIn(LocalTensor<float>& fbuf, LocalTensor<T>& raw,
                              GlobalTensor<T>& src, uint32_t offset, uint32_t len) {
    DataCopyExtParams params{1, (uint32_t)(len * sizeof(T)), 0, 0, 0};
    DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
    if constexpr (sizeof(T) == 4) {
        DataCopyPad(fbuf, src[offset], params, padParams);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
    } else {
        DataCopyPad(raw, src[offset], params, padParams);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Cast(fbuf, raw, RoundMode::CAST_NONE, len);
    }
}

template<typename T>
__aicore__ inline void CopyOut(GlobalTensor<T>& dst, LocalTensor<float>& fbuf,
                               LocalTensor<T>& raw, uint32_t offset, uint32_t len) {
    DataCopyExtParams params{1, (uint32_t)(len * sizeof(T)), 0, 0, 0};
    if constexpr (sizeof(T) == 4) {
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyPad(dst[offset], fbuf, params);
    } else {
        Cast(raw, fbuf, RoundMode::CAST_NONE, len);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyPad(dst[offset], raw, params);
    }
    SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
}

__aicore__ inline void ReduceMax(LocalTensor<float>& a, LocalTensor<float>& b, uint32_t n, LocalTensor<float>& res) {
    LocalTensor<float> src = a;
    LocalTensor<float> dst = b;
    uint32_t len = n;
    while (len > 1) {
        uint32_t half = len >> 1;
        if (half > 0) {
            Max(dst, src, src[half], half);
        }
        if (len & 1) {
            Adds(dst[half], src[len - 1], 0.0f, 1);
        }
        LocalTensor<float> tmp = src;
        src = dst;
        dst = tmp;
        len = (len + 1) >> 1;
    }
    Adds(res, src, 0.0f, 1);
}

__aicore__ inline void ReduceSum(LocalTensor<float>& a, LocalTensor<float>& b, uint32_t n, LocalTensor<float>& res) {
    LocalTensor<float> src = a;
    LocalTensor<float> dst = b;
    uint32_t len = n;
    while (len > 1) {
        uint32_t half = len >> 1;
        if (half > 0) {
            Add(dst, src, src[half], half);
        }
        if (len & 1) {
            Adds(dst[half], src[len - 1], 0.0f, 1);
        }
        LocalTensor<float> tmp = src;
        src = dst;
        dst = tmp;
        len = (len + 1) >> 1;
    }
    Adds(res, src, 0.0f, 1);
}

template<typename T>
class SoftmaxKernel {
public:
    __aicore__ inline void Init(__gm__ uint8_t* x, __gm__ uint8_t* y, uint32_t rowsIn, uint32_t dIn) {
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x));
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y));
        rows = rowsIn;
        D = dIn;
        blockIdx = GetBlockIdx();
        blockNum = GetBlockNum();
    }

    __aicore__ inline void Process() {
        LocalMemAllocator<Hardware::UB> alloc;
        LocalTensor<float> buf = alloc.Alloc<float>(TILE);
        LocalTensor<float> tmp = alloc.Alloc<float>(TILE);
        LocalTensor<float> acc = alloc.Alloc<float>(32);
        LocalTensor<float> scalar = alloc.Alloc<float>(32);
        LocalTensor<T> raw;
        if constexpr (sizeof(T) == 2) {
            raw = alloc.Alloc<T>(TILE);
        }

        for (uint32_t r = blockIdx; r < rows; r += blockNum) {
            uint32_t base = r * D;
            float maxVal = CalcMax(buf, tmp, acc, scalar, raw, base);
            float sumVal = CalcSum(buf, tmp, acc, scalar, raw, base, maxVal);
            WriteOut(buf, tmp, acc, scalar, raw, base, maxVal, sumVal);
        }
    }

private:
    __aicore__ inline float CalcMax(LocalTensor<float>& buf, LocalTensor<float>& tmp,
                                    LocalTensor<float>& acc, LocalTensor<float>& scalar,
                                    LocalTensor<T>& raw, uint32_t base) {
        bool first = true;
        for (uint32_t off = 0; off < D; off += TILE) {
            uint32_t len = D - off;
            if (len > TILE) len = TILE;
            CopyIn(buf, raw, xGm, base + off, len);
            ReduceMax(buf, tmp, len, scalar);
            if (first) {
                Adds(acc, scalar, 0.0f, 1);
                first = false;
            } else {
                Max(acc, acc, scalar, 1);
            }
            SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
        }
        SetFlag<HardEvent::V_S>(EVENT_ID0);
        WaitFlag<HardEvent::V_S>(EVENT_ID0);
        return acc.GetValue(0);
    }

    __aicore__ inline float CalcSum(LocalTensor<float>& buf, LocalTensor<float>& tmp,
                                    LocalTensor<float>& acc, LocalTensor<float>& scalar,
                                    LocalTensor<T>& raw, uint32_t base, float maxVal) {
        bool first = true;
        for (uint32_t off = 0; off < D; off += TILE) {
            uint32_t len = D - off;
            if (len > TILE) len = TILE;
            CopyIn(buf, raw, xGm, base + off, len);
            Adds(buf, buf, -maxVal, len);
            Exp(buf, buf, len);
            ReduceSum(buf, tmp, len, scalar);
            if (first) {
                Adds(acc, scalar, 0.0f, 1);
                first = false;
            } else {
                Add(acc, acc, scalar, 1);
            }
            SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
        }
        SetFlag<HardEvent::V_S>(EVENT_ID0);
        WaitFlag<HardEvent::V_S>(EVENT_ID0);
        return acc.GetValue(0);
    }

    __aicore__ inline void WriteOut(LocalTensor<float>& buf, LocalTensor<float>& tmp,
                                    LocalTensor<float>& acc, LocalTensor<float>& scalar,
                                    LocalTensor<T>& raw, uint32_t base, float maxVal, float sumVal) {
        float invSum = 1.0f / sumVal;
        for (uint32_t off = 0; off < D; off += TILE) {
            uint32_t len = D - off;
            if (len > TILE) len = TILE;
            CopyIn(buf, raw, xGm, base + off, len);
            Adds(buf, buf, -maxVal, len);
            Exp(buf, buf, len);
            Muls(buf, buf, invSum, len);
            CopyOut(yGm, buf, raw, base + off, len);
        }
    }

    GlobalTensor<T> xGm;
    GlobalTensor<T> yGm;
    uint32_t rows;
    uint32_t D;
    uint32_t blockIdx;
    uint32_t blockNum;
};

__global__ __vector__ void softmax_entry(
    __gm__ uint8_t* x,
    __gm__ uint8_t* y,
    uint32_t rows,
    uint32_t d,
    uint32_t dtype)
{
    AscendC::InitSocState();
    if (dtype == 0) {
        SoftmaxKernel<float> kernel;
        kernel.Init(x, y, rows, d);
        kernel.Process();
    } else if (dtype == 1) {
        SoftmaxKernel<half> kernel;
        kernel.Init(x, y, rows, d);
        kernel.Process();
    } else {
        SoftmaxKernel<bfloat16_t> kernel;
        kernel.Init(x, y, rows, d);
        kernel.Process();
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ==================== ASCEND_HOST_SECTION ====================

#include <torch/library.h>
#include <ATen/ATen.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"

at::Tensor run(const at::Tensor& x, int64_t dim) {
    (void)dim;
    at::Tensor y = at::empty_like(x);
    uint32_t d = (uint32_t)x.size(-1);
    uint32_t rows = (uint32_t)(x.numel() / (int64_t)d);
    uint32_t dtype = 0;
    if (x.scalar_type() == at::kHalf) {
        dtype = 1;
    } else if (x.scalar_type() == at::kBFloat16) {
        dtype = 2;
    }
    auto aclStream = c10_npu::getCurrentNPUStream().stream(false);
    softmax_entry_launch(20, (void*)aclStream, (uint8_t*)x.data_ptr(), (uint8_t*)y.data_ptr(), rows, d, dtype);
    return y;
}

TORCH_LIBRARY(custom_op, m) {
    m.def("run(Tensor x, int dim) -> Tensor");
}

TORCH_LIBRARY_IMPL(custom_op, PrivateUse1, m) {
    m.impl("run", run);
}
