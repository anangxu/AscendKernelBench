#include "kernel_operator.h"

using namespace AscendC;

class SwiGluFloatKernel {
public:
    __aicore__ inline SwiGluFloatKernel() {}

    __aicore__ inline void Init(__gm__ float* x, __gm__ float* y, uint32_t L, uint32_t N) {
        xGm_.SetGlobalBuffer(x, (uint32_t)((uint64_t)N * 2));
        yGm_.SetGlobalBuffer(y, (uint32_t)N);
        L_ = L;
        N_ = N;
    }

    __aicore__ inline void Process() {
        if (L_ == 0 || N_ == 0) {
            return;
        }
        uint32_t blockNum = GetBlockNum();
        uint32_t blockIdx = GetBlockIdx();
        uint64_t total = N_;
        uint64_t per = (total + blockNum - 1) / blockNum;
        uint64_t start = (uint64_t)blockIdx * per;
        if (start >= total) {
            return;
        }
        uint64_t end = start + per;
        if (end > total) {
            end = total;
        }

        LocalMemAllocator<Hardware::UB> allocator;
        constexpr uint32_t TILE = 2048;
        LocalTensor<float> xLocal = allocator.Alloc<float>(TILE);
        LocalTensor<float> bLocal = allocator.Alloc<float>(TILE);
        LocalTensor<float> yLocal = allocator.Alloc<float>(TILE);
        LocalTensor<float> tmpLocal = allocator.Alloc<float>(TILE);

        DataCopyPadExtParams<float> padParams{false, 0, 0, 0.0f};
        uint64_t cur = start;
        uint32_t chunk = (uint32_t)(cur / L_);
        uint32_t j = (uint32_t)(cur % L_);
        bool first = true;
        while (cur < end) {
            uint32_t remainInChunk = L_ - j;
            uint64_t remainTotal = end - cur;
            uint32_t count = TILE;
            if (count > remainInChunk) {
                count = remainInChunk;
            }
            if ((uint64_t)count > remainTotal) {
                count = (uint32_t)remainTotal;
            }

            uint32_t src0 = chunk * (2u * L_) + j;
            uint32_t src1 = src0 + L_;
            uint32_t dst = (uint32_t)cur;

            if (!first) {
                WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            }

            DataCopyExtParams inParams{1, (uint32_t)(count * sizeof(float)), 0, 0, 0};
            DataCopyPad(xLocal, xGm_[src0], inParams, padParams);
            DataCopyPad(bLocal, xGm_[src1], inParams, padParams);

            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);

            Muls(tmpLocal, xLocal, -1.0f, count);
            Exp(tmpLocal, tmpLocal, count);
            Adds(tmpLocal, tmpLocal, 1.0f, count);
            Div(yLocal, xLocal, tmpLocal, count);
            Mul(yLocal, yLocal, bLocal, count);

            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            SetFlag<HardEvent::V_MTE2>(EVENT_ID0);

            DataCopyExtParams outParams{1, (uint32_t)(count * sizeof(float)), 0, 0, 0};
            DataCopyPad(yGm_[dst], yLocal, outParams);
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);

            cur += count;
            j += count;
            if (j == L_) {
                ++chunk;
                j = 0;
            }
            first = false;
        }

        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    }

private:
    GlobalTensor<float> xGm_;
    GlobalTensor<float> yGm_;
    uint32_t L_ = 0;
    uint32_t N_ = 0;
};

template <typename T>
class SwiGluHalfKernel {
public:
    __aicore__ inline SwiGluHalfKernel() {}

    __aicore__ inline void Init(__gm__ uint16_t* x, __gm__ uint16_t* y, uint32_t L, uint32_t N) {
        xGm_.SetGlobalBuffer((__gm__ T*)x, (uint32_t)((uint64_t)N * 2));
        yGm_.SetGlobalBuffer((__gm__ T*)y, (uint32_t)N);
        L_ = L;
        N_ = N;
    }

    __aicore__ inline void Process() {
        if (L_ == 0 || N_ == 0) {
            return;
        }
        uint32_t blockNum = GetBlockNum();
        uint32_t blockIdx = GetBlockIdx();
        uint64_t total = N_;
        uint64_t per = (total + blockNum - 1) / blockNum;
        uint64_t start = (uint64_t)blockIdx * per;
        if (start >= total) {
            return;
        }
        uint64_t end = start + per;
        if (end > total) {
            end = total;
        }

        LocalMemAllocator<Hardware::UB> allocator;
        constexpr uint32_t TILE = 2048;
        LocalTensor<T> xLocal = allocator.Alloc<T>(TILE);
        LocalTensor<T> bLocal = allocator.Alloc<T>(TILE);
        LocalTensor<T> yLocal = allocator.Alloc<T>(TILE);
        LocalTensor<float> xLocalF = allocator.Alloc<float>(TILE);
        LocalTensor<float> bLocalF = allocator.Alloc<float>(TILE);
        LocalTensor<float> tmpLocalF = allocator.Alloc<float>(TILE);
        LocalTensor<float> yLocalF = allocator.Alloc<float>(TILE);

        DataCopyPadExtParams<T> padParams{false, 0, 0, T(0)};
        uint64_t cur = start;
        uint32_t chunk = (uint32_t)(cur / L_);
        uint32_t j = (uint32_t)(cur % L_);
        bool first = true;
        while (cur < end) {
            uint32_t remainInChunk = L_ - j;
            uint64_t remainTotal = end - cur;
            uint32_t count = TILE;
            if (count > remainInChunk) {
                count = remainInChunk;
            }
            if ((uint64_t)count > remainTotal) {
                count = (uint32_t)remainTotal;
            }

            uint32_t src0 = chunk * (2u * L_) + j;
            uint32_t src1 = src0 + L_;
            uint32_t dst = (uint32_t)cur;

            if (!first) {
                WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            }

            DataCopyExtParams inParams{1, (uint32_t)(count * sizeof(T)), 0, 0, 0};
            DataCopyPad(xLocal, xGm_[src0], inParams, padParams);
            DataCopyPad(bLocal, xGm_[src1], inParams, padParams);

            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);

            Cast(xLocalF, xLocal, RoundMode::CAST_NONE, count);
            Cast(bLocalF, bLocal, RoundMode::CAST_NONE, count);
            Muls(tmpLocalF, xLocalF, -1.0f, count);
            Exp(tmpLocalF, tmpLocalF, count);
            Adds(tmpLocalF, tmpLocalF, 1.0f, count);
            Div(yLocalF, xLocalF, tmpLocalF, count);
            Mul(yLocalF, yLocalF, bLocalF, count);
            Cast(yLocal, yLocalF, RoundMode::CAST_RINT, count);

            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            SetFlag<HardEvent::V_MTE2>(EVENT_ID0);

            DataCopyExtParams outParams{1, (uint32_t)(count * sizeof(T)), 0, 0, 0};
            DataCopyPad(yGm_[dst], yLocal, outParams);
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);

            cur += count;
            j += count;
            if (j == L_) {
                ++chunk;
                j = 0;
            }
            first = false;
        }

        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    }

private:
    GlobalTensor<T> xGm_;
    GlobalTensor<T> yGm_;
    uint32_t L_ = 0;
    uint32_t N_ = 0;
};

__global__ __vector__ void swiglu_fp32(__gm__ float* x, __gm__ float* y, uint32_t L, uint32_t N) {
    AscendC::InitSocState();
    SwiGluFloatKernel op;
    op.Init(x, y, L, N);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

__global__ __vector__ void swiglu_fp16(__gm__ uint16_t* x, __gm__ uint16_t* y, uint32_t L, uint32_t N) {
    AscendC::InitSocState();
    SwiGluHalfKernel<half> op;
    op.Init(x, y, L, N);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

__global__ __vector__ void swiglu_bf16(__gm__ uint16_t* x, __gm__ uint16_t* y, uint32_t L, uint32_t N) {
    AscendC::InitSocState();
    SwiGluHalfKernel<bfloat16_t> op;
    op.Init(x, y, L, N);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ==================== ASCEND_HOST_SECTION ====================

#include <torch/library.h>
#include <ATen/ATen.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"

at::Tensor run(const at::Tensor& x, int64_t dim) {
    int64_t nd = x.dim();
    if (dim < 0) {
        dim += nd;
    }
    TORCH_CHECK(dim >= 0 && dim < nd, "invalid dim");
    int64_t D = x.size(dim);
    TORCH_CHECK((D & 1) == 0, "dim size must be even");
    int64_t outer = 1;
    for (int64_t i = 0; i < dim; ++i) {
        outer *= x.size(i);
    }
    int64_t inner = 1;
    for (int64_t i = dim + 1; i < nd; ++i) {
        inner *= x.size(i);
    }
    int64_t half = D / 2;
    int64_t L = half * inner;
    int64_t N = outer * L;

    at::Tensor y = at::empty_like(x);
    if (N == 0) {
        return y;
    }

    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    int numBlocks = 40;
    if (N < numBlocks) {
        numBlocks = static_cast<int>(N);
    }
    auto dtype = x.scalar_type();
    if (dtype == at::kFloat) {
        swiglu_fp32_launch(numBlocks, (void*)stream,
            (float*)x.data_ptr(), (float*)y.data_ptr(),
            (uint32_t)L, (uint32_t)N);
    } else if (dtype == at::kHalf) {
        swiglu_fp16_launch(numBlocks, (void*)stream,
            (uint16_t*)x.data_ptr(), (uint16_t*)y.data_ptr(),
            (uint32_t)L, (uint32_t)N);
    } else if (dtype == at::kBFloat16) {
        swiglu_bf16_launch(numBlocks, (void*)stream,
            (uint16_t*)x.data_ptr(), (uint16_t*)y.data_ptr(),
            (uint32_t)L, (uint32_t)N);
    } else {
        TORCH_CHECK(false, "unsupported dtype");
    }
    return y;
}

TORCH_LIBRARY(custom_op, m) {
    m.def("run(Tensor x, int dim) -> Tensor", &run);
}

TORCH_LIBRARY_IMPL(custom_op, PrivateUse1, m) {
    m.impl("run", &run);
}
