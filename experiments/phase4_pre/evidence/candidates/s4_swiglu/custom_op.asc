#include "kernel_operator.h"

using namespace AscendC;

// SwiGLU with single-input half split:
//   view x as [outer, D, inner], half = D/2, blockLen = half * inner
//   y[o, i, j] = silu(x[o, i, j]) * x[o, i + half, j]
// The operator reduces to an element-wise zip of two contiguous segments of
// length blockLen per outer row, so the kernel tiles the (row, tile) space
// evenly across all AI cores.
template <typename T>
class SwiGLUKernel {
public:
    __aicore__ inline SwiGLUKernel()
        : rows_(0), blockLen_(0), tilesPerRow_(1), tileStart_(0), tileEnd_(0)
    {
    }

    __aicore__ inline void Init(__gm__ uint8_t* x, __gm__ uint8_t* y,
                                uint32_t rows, uint32_t blockLen)
    {
        constexpr uint32_t TILE = (sizeof(T) == 4u) ? 4096u : 8192u;
        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x));
        yGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y));
        rows_ = rows;
        blockLen_ = blockLen;
        tilesPerRow_ = (blockLen_ + TILE - 1u) / TILE;
        if (tilesPerRow_ == 0u) {
            tilesPerRow_ = 1u;
        }
        uint64_t totalTiles = (uint64_t)rows_ * (uint64_t)tilesPerRow_;
        uint32_t numBlocks = GetBlockNum();
        if (numBlocks == 0u) {
            numBlocks = 1u;
        }
        uint64_t perCore = (totalTiles + (uint64_t)numBlocks - 1u) / (uint64_t)numBlocks;
        uint64_t s = (uint64_t)GetBlockIdx() * perCore;
        uint64_t e = s + perCore;
        if (s > totalTiles) {
            s = totalTiles;
        }
        if (e > totalTiles) {
            e = totalTiles;
        }
        tileStart_ = (uint32_t)s;
        tileEnd_ = (uint32_t)e;
    }

    __aicore__ inline void Process()
    {
        if (blockLen_ == 0u || tileStart_ >= tileEnd_) {
            return;
        }
        constexpr uint32_t TILE = (sizeof(T) == 4u) ? 4096u : 8192u;

        LocalMemAllocator<Hardware::UB> allocator;
        LocalTensor<T> aL = allocator.Alloc<T>(TILE);   // first half  (silu input)
        LocalTensor<T> bL = allocator.Alloc<T>(TILE);   // second half (gate)
        LocalTensor<T> cL = allocator.Alloc<T>(TILE);   // scratch

        for (uint32_t t = tileStart_; t < tileEnd_; ++t) {
            uint32_t r = t / tilesPerRow_;
            uint32_t k = t - r * tilesPerRow_;
            uint32_t off = k * TILE;
            uint32_t n = blockLen_ - off;
            if (n > TILE) {
                n = TILE;
            }
            int32_t nInt = (int32_t)n;
            uint32_t nBytes = n * (uint32_t)sizeof(T);
            uint32_t srcBase = r * (blockLen_ * 2u) + off;
            uint32_t dstBase = r * blockLen_ + off;

            DataCopyExtParams cpIn{1, nBytes, 0, 0, 0};
            DataCopyPadExtParams<T> pp{false, 0, 0, 0};
            DataCopyPad(aL, xGm_[srcBase], cpIn, pp);
            DataCopyPad(bL, xGm_[srcBase + blockLen_], cpIn, pp);

            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);

            // silu(a) = a / (1 + exp(-a))
            Muls(cL, aL, (T)(-1.0f), nInt);
            Exp(cL, cL, nInt);
            Adds(cL, cL, (T)(1.0f), nInt);
            Div(aL, aL, cL, nInt);
            Mul(aL, aL, bL, nInt);

            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);

            DataCopyExtParams cpOut{1, nBytes, 0, 0, 0};
            DataCopyPad(yGm_[dstBase], aL, cpOut);

            SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
        }
    }

private:
    GlobalTensor<T> xGm_;
    GlobalTensor<T> yGm_;
    uint32_t rows_;
    uint32_t blockLen_;
    uint32_t tilesPerRow_;
    uint32_t tileStart_;
    uint32_t tileEnd_;
};

__global__ __vector__ void swiglu_fp32(__gm__ uint8_t* x, __gm__ uint8_t* y,
                                       uint32_t rows, uint32_t blockLen)
{
    AscendC::InitSocState();
    SwiGLUKernel<float> op;
    op.Init(x, y, rows, blockLen);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

__global__ __vector__ void swiglu_fp16(__gm__ uint8_t* x, __gm__ uint8_t* y,
                                       uint32_t rows, uint32_t blockLen)
{
    AscendC::InitSocState();
    SwiGLUKernel<half> op;
    op.Init(x, y, rows, blockLen);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

__global__ __vector__ void swiglu_bf16(__gm__ uint8_t* x, __gm__ uint8_t* y,
                                       uint32_t rows, uint32_t blockLen)
{
    AscendC::InitSocState();
    SwiGLUKernel<bfloat16_t> op;
    op.Init(x, y, rows, blockLen);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ==================== ASCEND_HOST_SECTION ====================

#include <torch/library.h>
#include <ATen/ATen.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"

namespace {

constexpr uint32_t kMaxBlocks = 20;

at::Tensor swiglu_run(const at::Tensor& x_in, int64_t dim)
{
    at::Tensor x = x_in.is_contiguous() ? x_in : x_in.contiguous();
    int64_t nd = x.dim();
    TORCH_CHECK(nd >= 1, "swiglu: input must have at least one dimension");

    int64_t d = dim;
    if (d < 0) {
        d += nd;
    }
    TORCH_CHECK(d >= 0 && d < nd, "swiglu: dim out of range");

    int64_t D = x.size(d);
    int64_t half = D / 2;

    auto outSizes = x.sizes().vec();
    outSizes[d] = half;
    at::Tensor y = at::empty(outSizes, x.options());
    if (half <= 0) {
        return y;
    }

    int64_t outer = 1;
    for (int64_t i = 0; i < d; ++i) {
        outer *= x.size(i);
    }
    int64_t inner = 1;
    for (int64_t i = d + 1; i < nd; ++i) {
        inner *= x.size(i);
    }
    int64_t blockLen = half * inner;
    if (outer <= 0 || blockLen <= 0) {
        return y;
    }

    uint32_t rows = (uint32_t)outer;
    uint32_t bl = (uint32_t)blockLen;

    uint32_t tilesPerRow = (bl + 4095u) / 4096u;
    if (tilesPerRow == 0u) {
        tilesPerRow = 1u;
    }
    uint64_t totalTiles = (uint64_t)rows * (uint64_t)tilesPerRow;
    uint32_t blocks = kMaxBlocks;
    if (totalTiles < (uint64_t)blocks) {
        blocks = (uint32_t)totalTiles;
    }
    if (blocks == 0u) {
        blocks = 1u;
    }

    auto aclStream = c10_npu::getCurrentNPUStream().stream(false);
    uint8_t* xp = reinterpret_cast<uint8_t*>(x.data_ptr());
    uint8_t* yp = reinterpret_cast<uint8_t*>(y.data_ptr());

    switch (x.scalar_type()) {
        case at::kFloat:
            swiglu_fp32_launch(blocks, (void*)aclStream, xp, yp, rows, bl);
            break;
        case at::kHalf:
            swiglu_fp16_launch(blocks, (void*)aclStream, xp, yp, rows, bl);
            break;
        case at::kBFloat16:
            swiglu_bf16_launch(blocks, (void*)aclStream, xp, yp, rows, bl);
            break;
        default:
            TORCH_CHECK(false, "swiglu: unsupported dtype");
    }
    return y;
}

}  // namespace

TORCH_LIBRARY(custom_op, m)
{
    m.def("run(Tensor x, int dim) -> Tensor");
}

TORCH_LIBRARY_IMPL(custom_op, PrivateUse1, m)
{
    m.impl("run", swiglu_run);
}
