#include "kernel_operator.h"

using namespace AscendC;

namespace {
constexpr int32_t TILE = 1024;
}

__aicore__ inline float ReduceSumF(LocalTensor<float>& buf, int32_t count)
{
    int32_t n = count;
    while (n > 1) {
        int32_t half = (n + 1) >> 1;
        int32_t m = n - half;
        if (m > 0) {
            Add(buf, buf, buf[(uint32_t)half], m);
        }
        n = half;
    }
    SetFlag<HardEvent::V_S>(EVENT_ID4);
    WaitFlag<HardEvent::V_S>(EVENT_ID4);
    float v = buf.GetValue(0);
    return v;
}

__aicore__ inline float ScalarSqrt(float v, LocalTensor<float>& tmp)
{
    tmp.SetValue(0, v);
    SetFlag<HardEvent::S_V>(EVENT_ID5);
    WaitFlag<HardEvent::S_V>(EVENT_ID5);
    Sqrt(tmp, tmp, 1);
    SetFlag<HardEvent::V_S>(EVENT_ID5);
    WaitFlag<HardEvent::V_S>(EVENT_ID5);
    float r = tmp.GetValue(0);
    return r;
}

template <typename T>
struct Cvt {
    static __aicore__ inline void toF(LocalTensor<float>& d, const LocalTensor<T>& s, int32_t n)
    {
        Cast(d, s, RoundMode::CAST_NONE, n);
    }
    static __aicore__ inline void fromF(LocalTensor<T>& d, const LocalTensor<float>& s, int32_t n)
    {
        Cast(d, s, RoundMode::CAST_RINT, n);
    }
};

template <>
struct Cvt<float> {
    static __aicore__ inline void toF(LocalTensor<float>& d, const LocalTensor<float>& s, int32_t n)
    {
        Muls(d, s, 1.0f, n);
    }
    static __aicore__ inline void fromF(LocalTensor<float>& d, const LocalTensor<float>& s, int32_t n)
    {
        Muls(d, s, 1.0f, n);
    }
};

template <typename T>
class RmsNormKernel {
public:
    __aicore__ inline void Init(__gm__ uint8_t* x, __gm__ uint8_t* gamma, __gm__ uint8_t* y,
                                uint32_t rows, uint32_t D, float eps)
    {
        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x));
        gGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(gamma));
        yGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y));
        rows_ = rows;
        D_ = D;
        eps_ = eps;

        uint32_t bn = (uint32_t)GetBlockNum();
        if (bn == 0) {
            bn = 1;
        }
        uint32_t bi = (uint32_t)GetBlockIdx();
        uint32_t per = (rows + bn - 1) / bn;
        if (per == 0) {
            per = 1;
        }
        uint64_t s = (uint64_t)bi * (uint64_t)per;
        uint64_t e = s + (uint64_t)per;
        if (s > rows) {
            s = rows;
        }
        if (e > rows) {
            e = rows;
        }
        rowStart_ = (uint32_t)s;
        rowEnd_ = (uint32_t)e;
    }

    __aicore__ inline void Process()
    {
        if (rowStart_ >= rowEnd_) {
            return;
        }

        LocalMemAllocator<Hardware::UB> allocator;
        LocalTensor<T> xBuf = allocator.Alloc<T>(TILE);
        LocalTensor<T> gBuf = allocator.Alloc<T>(TILE);
        LocalTensor<float> fBuf = allocator.Alloc<float>(TILE);
        LocalTensor<float> gF = allocator.Alloc<float>(TILE);

        for (uint32_t r = rowStart_; r < rowEnd_; ++r) {
            int64_t base = (int64_t)r * (int64_t)D_;

            float total = 0.0f;
            for (uint32_t off = 0; off < D_; off += (uint32_t)TILE) {
                int32_t cnt = (int32_t)(((D_ - off) < (uint32_t)TILE) ? (D_ - off) : (uint32_t)TILE);
                DataCopyExtParams cp{1, (uint32_t)(cnt * (int32_t)sizeof(T)), 0, 0, 0};
                DataCopyPadExtParams<T> pp{false, 0, 0};
                DataCopyPad(xBuf, xGm_[base + (int64_t)off], cp, pp);
                SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);

                Cvt<T>::toF(fBuf, xBuf, cnt);
                Mul(fBuf, fBuf, fBuf, cnt);
                float ts = ReduceSumF(fBuf, cnt);
                total += ts;

                SetFlag<HardEvent::V_MTE2>(EVENT_ID2);
                WaitFlag<HardEvent::V_MTE2>(EVENT_ID2);
            }

            float mean = total / (float)D_;
            float rms = ScalarSqrt(mean + eps_, fBuf);
            float inv = 1.0f / rms;

            for (uint32_t off = 0; off < D_; off += (uint32_t)TILE) {
                int32_t cnt = (int32_t)(((D_ - off) < (uint32_t)TILE) ? (D_ - off) : (uint32_t)TILE);
                DataCopyExtParams cpx{1, (uint32_t)(cnt * (int32_t)sizeof(T)), 0, 0, 0};
                DataCopyPadExtParams<T> ppx{false, 0, 0};
                DataCopyPad(xBuf, xGm_[base + (int64_t)off], cpx, ppx);
                DataCopyPad(gBuf, gGm_[(int64_t)off], cpx, ppx);
                SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);

                Cvt<T>::toF(fBuf, xBuf, cnt);
                Muls(fBuf, fBuf, inv, cnt);
                Cvt<T>::toF(gF, gBuf, cnt);
                Mul(fBuf, fBuf, gF, cnt);
                Cvt<T>::fromF(xBuf, fBuf, cnt);

                SetFlag<HardEvent::V_MTE3>(EVENT_ID1);
                WaitFlag<HardEvent::V_MTE3>(EVENT_ID1);
                DataCopyExtParams cpy{1, (uint32_t)(cnt * (int32_t)sizeof(T)), 0, 0, 0};
                DataCopyPad(yGm_[base + (int64_t)off], xBuf, cpy);

                SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID3);
                WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID3);
            }
        }
    }

private:
    GlobalTensor<T> xGm_;
    GlobalTensor<T> gGm_;
    GlobalTensor<T> yGm_;
    uint32_t rows_ = 0;
    uint32_t D_ = 0;
    uint32_t rowStart_ = 0;
    uint32_t rowEnd_ = 0;
    float eps_ = 0.0f;
};

__global__ __vector__ void rms_norm_fp32(__gm__ uint8_t* x, __gm__ uint8_t* gamma, __gm__ uint8_t* y,
                                         uint32_t rows, uint32_t D, float eps)
{
    AscendC::InitSocState();
    RmsNormKernel<float> op;
    op.Init(x, gamma, y, rows, D, eps);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

__global__ __vector__ void rms_norm_fp16(__gm__ uint8_t* x, __gm__ uint8_t* gamma, __gm__ uint8_t* y,
                                         uint32_t rows, uint32_t D, float eps)
{
    AscendC::InitSocState();
    RmsNormKernel<half> op;
    op.Init(x, gamma, y, rows, D, eps);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

__global__ __vector__ void rms_norm_bf16(__gm__ uint8_t* x, __gm__ uint8_t* gamma, __gm__ uint8_t* y,
                                         uint32_t rows, uint32_t D, float eps)
{
    AscendC::InitSocState();
    RmsNormKernel<bfloat16_t> op;
    op.Init(x, gamma, y, rows, D, eps);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

__global__ __vector__ void rms_norm_int32(__gm__ uint8_t* x, __gm__ uint8_t* gamma, __gm__ uint8_t* y,
                                          uint32_t rows, uint32_t D, float eps)
{
    AscendC::InitSocState();
    RmsNormKernel<int32_t> op;
    op.Init(x, gamma, y, rows, D, eps);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

__global__ __vector__ void rms_norm_int64(__gm__ uint8_t* x, __gm__ uint8_t* gamma, __gm__ uint8_t* y,
                                          uint32_t rows, uint32_t D, float eps)
{
    AscendC::InitSocState();
    RmsNormKernel<int64_t> op;
    op.Init(x, gamma, y, rows, D, eps);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ==================== ASCEND_HOST_SECTION ====================

#include <torch/library.h>
#include <ATen/ATen.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"

namespace {

void launch_rms(const at::Tensor& x, const at::Tensor& gamma, at::Tensor& y, double eps)
{
    const int64_t D = x.size(-1);
    const int64_t numel = x.numel();
    if (D <= 0 || numel <= 0) {
        return;
    }
    const int64_t rows = numel / D;
    if (rows <= 0) {
        return;
    }

    int numBlocks = (rows < 40) ? (int)rows : 40;
    if (numBlocks < 1) {
        numBlocks = 1;
    }

    void* aclStream = (void*)c10_npu::getCurrentNPUStream().stream(false);
    const uint32_t urows = (uint32_t)rows;
    const uint32_t uD = (uint32_t)D;
    const float feps = (float)eps;

    uint8_t* xp = (uint8_t*)x.data_ptr();
    uint8_t* gp = (uint8_t*)gamma.data_ptr();
    uint8_t* yp = (uint8_t*)y.data_ptr();

    auto st = x.scalar_type();
    if (st == at::kFloat) {
        rms_norm_fp32_launch(numBlocks, aclStream, xp, gp, yp, urows, uD, feps);
    } else if (st == at::kHalf) {
        rms_norm_fp16_launch(numBlocks, aclStream, xp, gp, yp, urows, uD, feps);
    } else if (st == at::kBFloat16) {
        rms_norm_bf16_launch(numBlocks, aclStream, xp, gp, yp, urows, uD, feps);
    } else if (st == at::kInt) {
        rms_norm_int32_launch(numBlocks, aclStream, xp, gp, yp, urows, uD, feps);
    } else if (st == at::kLong) {
        rms_norm_int64_launch(numBlocks, aclStream, xp, gp, yp, urows, uD, feps);
    }
}

at::Tensor run(const at::Tensor& x, const at::Tensor& gamma, double eps)
{
    at::Tensor y = at::empty_like(x);
    launch_rms(x, gamma, y, eps);
    return y;
}

}  // namespace

TORCH_LIBRARY(custom_op, m)
{
    m.def("run(Tensor x, Tensor gamma, float eps) -> Tensor");
}

TORCH_LIBRARY_IMPL(custom_op, PrivateUse1, m)
{
    m.impl("run", &run);
}
