#include "kernel_operator.h"

using namespace AscendC;

namespace rmsnorm_ns {

constexpr uint32_t CHUNK = 1024u;

template <typename T>
__aicore__ inline void CopyInT(const LocalTensor<T>& dst, const GlobalTensor<T>& src, uint32_t cnt)
{
    DataCopyExtParams cp;
    cp.blockCount = 1;
    cp.blockLen = (uint32_t)(cnt * sizeof(T));
    cp.srcStride = 0;
    cp.dstStride = 0;
    cp.rsv = 0;
    DataCopyPadExtParams<T> pp;
    pp.isPad = false;
    pp.leftPadding = 0;
    pp.rightPadding = 0;
    pp.paddingValue = (T)0;
    DataCopyPad(dst, src, cp, pp);
}

template <typename T>
__aicore__ inline void CopyOutT(const GlobalTensor<T>& dst, const LocalTensor<T>& src, uint32_t cnt)
{
    DataCopyExtParams cp;
    cp.blockCount = 1;
    cp.blockLen = (uint32_t)(cnt * sizeof(T));
    cp.srcStride = 0;
    cp.dstStride = 0;
    cp.rsv = 0;
    DataCopyPad(dst, src, cp);
}

template <typename T>
__aicore__ inline void LoadToFloat(const LocalTensor<float>& dst,
                                   const LocalTensor<T>& raw,
                                   const LocalTensor<int32_t>& i32,
                                   const GlobalTensor<T>& src,
                                   uint32_t cnt)
{
    if constexpr (IsSameType<T, float>::value) {
        CopyInT<float>(dst, src, cnt);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
    } else {
        CopyInT<T>(raw, src, cnt);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        if constexpr (IsSameType<T, int64_t>::value) {
            Cast(i32, raw, RoundMode::CAST_NONE, cnt);
            PipeBarrier<PIPE_V>();
            Cast(dst, i32, RoundMode::CAST_NONE, cnt);
        } else {
            Cast(dst, raw, RoundMode::CAST_NONE, cnt);
        }
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
    }
}

template <typename T>
__aicore__ inline void StoreFromFloat(const LocalTensor<float>& src,
                                      const LocalTensor<T>& raw,
                                      const LocalTensor<int32_t>& i32,
                                      const GlobalTensor<T>& dstGm,
                                      uint32_t cnt)
{
    if constexpr (IsSameType<T, float>::value) {
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        CopyOutT<float>(dstGm, src, cnt);
        SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
    } else {
        if constexpr (IsSameType<T, int64_t>::value) {
            Cast(i32, src, RoundMode::CAST_RINT, cnt);
            PipeBarrier<PIPE_V>();
            Cast(raw, i32, RoundMode::CAST_NONE, cnt);
        } else if constexpr (IsSameType<T, int32_t>::value) {
            Cast(raw, src, RoundMode::CAST_RINT, cnt);
        } else if constexpr (IsSameType<T, bfloat16_t>::value) {
            Cast(raw, src, RoundMode::CAST_RINT, cnt);
        } else {
            Cast(raw, src, RoundMode::CAST_NONE, cnt);
        }
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        CopyOutT<T>(dstGm, raw, cnt);
        SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
    }
}

__aicore__ inline float ReduceBuf(const LocalTensor<float>& buf, uint32_t n)
{
    while (n > 16u) {
        uint32_t h = n >> 1;
        Add(buf, buf, buf[(int32_t)h], h);
        PipeBarrier<PIPE_V>();
        if ((n & 1u) != 0u) {
            PipeBarrier<PIPE_ALL>();
            float v = buf.GetValue((int32_t)(2u * h));
            buf.SetValue((int32_t)h, v);
            PipeBarrier<PIPE_ALL>();
            n = h + 1u;
        } else {
            n = h;
        }
    }
    PipeBarrier<PIPE_ALL>();
    float s = 0.0f;
    for (uint32_t i = 0; i < n; ++i) {
        s += buf.GetValue((int32_t)i);
    }
    return s;
}

template <typename T>
class RmsNormKernel {
public:
    __aicore__ inline void Init(__gm__ uint8_t* xp, __gm__ uint8_t* gp, __gm__ uint8_t* yp,
                                uint32_t rows, uint32_t D, float eps)
    {
        rows_ = rows;
        D_ = D;
        eps_ = eps;
        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(xp), (uint64_t)rows * (uint64_t)D);
        gGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(gp), (uint64_t)D);
        yGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(yp), (uint64_t)rows * (uint64_t)D);
    }

    __aicore__ inline void Process()
    {
        LocalMemAllocator<Hardware::UB> alloc;
        LocalTensor<T> rawA = alloc.Alloc<T>(CHUNK);
        LocalTensor<T> rawB = alloc.Alloc<T>(CHUNK);
        LocalTensor<int32_t> i32A = alloc.Alloc<int32_t>(CHUNK);
        LocalTensor<int32_t> i32B = alloc.Alloc<int32_t>(CHUNK);
        LocalTensor<float> aF = alloc.Alloc<float>(CHUNK);
        LocalTensor<float> gF = alloc.Alloc<float>(CHUNK);
        LocalTensor<float> tmp = alloc.Alloc<float>(CHUNK);

        uint32_t bid = (uint32_t)GetBlockIdx();
        uint32_t bnum = (uint32_t)GetBlockNum();
        if (bnum == 0u) {
            bnum = 1u;
        }
        uint32_t rowStart = (uint32_t)(((uint64_t)rows_ * (uint64_t)bid) / (uint64_t)bnum);
        uint32_t rowEnd = (uint32_t)(((uint64_t)rows_ * (uint64_t)(bid + 1u)) / (uint64_t)bnum);

        for (uint32_t r = rowStart; r < rowEnd; ++r) {
            uint64_t base = (uint64_t)r * (uint64_t)D_;

            float total = 0.0f;
            for (uint32_t off = 0; off < D_; off += CHUNK) {
                uint32_t cnt = D_ - off;
                if (cnt > CHUNK) {
                    cnt = CHUNK;
                }
                LoadToFloat<T>(aF, rawA, i32A, xGm_[base + (uint64_t)off], cnt);
                Mul(tmp, aF, aF, cnt);
                PipeBarrier<PIPE_V>();
                total += ReduceBuf(tmp, cnt);
            }

            float mean = total / (float)D_;
            float rstd = 1.0f / sqrt(mean + eps_);

            for (uint32_t off = 0; off < D_; off += CHUNK) {
                uint32_t cnt = D_ - off;
                if (cnt > CHUNK) {
                    cnt = CHUNK;
                }
                LoadToFloat<T>(aF, rawA, i32A, xGm_[base + (uint64_t)off], cnt);
                LoadToFloat<T>(gF, rawB, i32B, gGm_[(uint64_t)off], cnt);
                Muls(aF, aF, rstd, cnt);
                Mul(aF, aF, gF, cnt);
                PipeBarrier<PIPE_V>();
                StoreFromFloat<T>(aF, rawA, i32A, yGm_[base + (uint64_t)off], cnt);
            }
        }
    }

private:
    GlobalTensor<T> xGm_;
    GlobalTensor<T> gGm_;
    GlobalTensor<T> yGm_;
    uint32_t rows_ = 0;
    uint32_t D_ = 0;
    float eps_ = 1e-6f;
};

}  // namespace rmsnorm_ns

__global__ __vector__ void rms_norm_kernel(
    __gm__ uint8_t* x,
    __gm__ uint8_t* gamma,
    __gm__ uint8_t* y,
    uint32_t rows,
    uint32_t D,
    float eps,
    uint32_t dtypeCode)
{
    AscendC::InitSocState();

    if (dtypeCode == 0u) {
        rmsnorm_ns::RmsNormKernel<half> k;
        k.Init(x, gamma, y, rows, D, eps);
        k.Process();
    } else if (dtypeCode == 1u) {
        rmsnorm_ns::RmsNormKernel<bfloat16_t> k;
        k.Init(x, gamma, y, rows, D, eps);
        k.Process();
    } else if (dtypeCode == 2u) {
        rmsnorm_ns::RmsNormKernel<float> k;
        k.Init(x, gamma, y, rows, D, eps);
        k.Process();
    } else if (dtypeCode == 3u) {
        rmsnorm_ns::RmsNormKernel<int32_t> k;
        k.Init(x, gamma, y, rows, D, eps);
        k.Process();
    } else {
        rmsnorm_ns::RmsNormKernel<int64_t> k;
        k.Init(x, gamma, y, rows, D, eps);
        k.Process();
    }

    AscendC::PipeBarrier<PIPE_ALL>();
}

// ==================== ASCEND_HOST_SECTION ====================

#include <torch/library.h>
#include <ATen/ATen.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"

namespace {

at::Tensor rms_norm_forward(const at::Tensor& x, const at::Tensor& gamma, double eps)
{
    int64_t D = x.size(-1);
    int64_t rows = x.numel() / D;

    at::Tensor y = at::empty_like(x);

    uint32_t dtypeCode = 2u;
    at::ScalarType st = x.scalar_type();
    if (st == at::ScalarType::Half) {
        dtypeCode = 0u;
    } else if (st == at::ScalarType::BFloat16) {
        dtypeCode = 1u;
    } else if (st == at::ScalarType::Float) {
        dtypeCode = 2u;
    } else if (st == at::ScalarType::Int) {
        dtypeCode = 3u;
    } else {
        dtypeCode = 4u;
    }

    void* aclStream = (void*)c10_npu::getCurrentNPUStream().stream(false);

    int numBlocks = 40;

    rms_norm_kernel_launch(numBlocks,
                           aclStream,
                           (uint8_t*)x.data_ptr(),
                           (uint8_t*)gamma.data_ptr(),
                           (uint8_t*)y.data_ptr(),
                           (uint32_t)rows,
                           (uint32_t)D,
                           (float)eps,
                           dtypeCode);

    return y;
}

}  // namespace

TORCH_LIBRARY(custom_op, m)
{
    m.def("rms_norm(Tensor x, Tensor gamma, float eps) -> Tensor");
}

TORCH_LIBRARY_IMPL(custom_op, PrivateUse1, m)
{
    m.impl("rms_norm", &rms_norm_forward);
}
