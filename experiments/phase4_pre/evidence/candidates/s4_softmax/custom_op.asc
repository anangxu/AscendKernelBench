#include "kernel_operator.h"

using namespace AscendC;

template <typename T>
class SoftmaxKernel {
public:
    __aicore__ inline void Init(__gm__ uint8_t* x, __gm__ uint8_t* y,
                                uint32_t outer, uint32_t dimSize,
                                uint32_t inner, uint32_t numBlocks) {
        xGm_ = reinterpret_cast<__gm__ T*>(x);
        yGm_ = reinterpret_cast<__gm__ T*>(y);
        outer_ = outer;
        dimSize_ = dimSize;
        inner_ = inner;
        numBlocks_ = numBlocks;
    }

    __aicore__ inline void Process() {
        if (inner_ == 1) {
            ProcessContiguous();
        } else {
            ProcessStrided();
        }
    }

private:
    static constexpr uint32_t CHUNK = 4096;

    __gm__ T* xGm_;
    __gm__ T* yGm_;
    uint32_t outer_;
    uint32_t dimSize_;
    uint32_t inner_;
    uint32_t numBlocks_;

    __aicore__ inline uint32_t MinU32(uint32_t a, uint32_t b) {
        return a < b ? a : b;
    }

    __aicore__ inline void SyncAll() {
        PipeBarrier<PIPE_ALL>();
    }

    __aicore__ inline void CopyIn(const LocalTensor<T>& dst, __gm__ T* src, uint32_t count) {
        GlobalTensor<T> g;
        g.SetGlobalBuffer(src, count);
        DataCopyExtParams params{1, (uint32_t)(count * sizeof(T)), 0, 0, 0};
        DataCopyPadExtParams<T> pad{false, 0, 0, (T)0};
        DataCopyPad(dst, g, params, pad);
    }

    __aicore__ inline void CopyOut(__gm__ T* dst, const LocalTensor<T>& src, uint32_t count) {
        GlobalTensor<T> g;
        g.SetGlobalBuffer(dst, count);
        DataCopyExtParams params{1, (uint32_t)(count * sizeof(T)), 0, 0, 0};
        DataCopyPad(g, src, params);
    }

    __aicore__ inline void WaitCopyIn() {
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        SyncAll();
    }

    __aicore__ inline void BeforeCopyOut() {
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
    }

    __aicore__ inline void AfterCopyOut() {
        SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
    }

    __aicore__ inline void ProcessContiguous() {
        LocalMemAllocator<Hardware::UB> allocator;
        allocator.Init();
        LocalTensor<T> in = allocator.Alloc<T>(CHUNK);
        LocalTensor<T> tmp = allocator.Alloc<T>(CHUNK);
        LocalTensor<T> out = allocator.Alloc<T>(CHUNK);

        uint32_t block = (uint32_t)GetBlockIdx();
        for (uint32_t row = block; row < outer_; row += numBlocks_) {
            __gm__ T* xr = xGm_ + (uint64_t)row * (uint64_t)dimSize_;
            __gm__ T* yr = yGm_ + (uint64_t)row * (uint64_t)dimSize_;
            float maxv = -3.402823466e38f;

            if (dimSize_ <= CHUNK) {
                CopyIn(in, xr, dimSize_);
                WaitCopyIn();

                for (uint32_t i = 0; i < dimSize_; ++i) {
                    float v = (float)in.GetValue(i);
                    if (v > maxv) maxv = v;
                }
                SyncAll();

                Adds(tmp, in, (T)(-maxv), dimSize_);
                Exp(out, tmp, dimSize_);
                SyncAll();

                float sum = 0.0f;
                for (uint32_t i = 0; i < dimSize_; ++i) {
                    sum += (float)out.GetValue(i);
                }
                float inv = 1.0f / sum;
                Muls(tmp, out, (T)inv, dimSize_);

                BeforeCopyOut();
                CopyOut(yr, tmp, dimSize_);
                AfterCopyOut();
            } else {
                for (uint32_t off = 0; off < dimSize_; off += CHUNK) {
                    uint32_t cnt = MinU32(CHUNK, dimSize_ - off);
                    CopyIn(in, xr + off, cnt);
                    WaitCopyIn();
                    for (uint32_t i = 0; i < cnt; ++i) {
                        float v = (float)in.GetValue(i);
                        if (v > maxv) maxv = v;
                    }
                    SyncAll();
                }

                float sum = 0.0f;
                for (uint32_t off = 0; off < dimSize_; off += CHUNK) {
                    uint32_t cnt = MinU32(CHUNK, dimSize_ - off);
                    CopyIn(in, xr + off, cnt);
                    WaitCopyIn();
                    Adds(tmp, in, (T)(-maxv), cnt);
                    Exp(out, tmp, cnt);
                    SyncAll();
                    for (uint32_t i = 0; i < cnt; ++i) {
                        sum += (float)out.GetValue(i);
                    }
                    SyncAll();
                }

                float inv = 1.0f / sum;
                for (uint32_t off = 0; off < dimSize_; off += CHUNK) {
                    uint32_t cnt = MinU32(CHUNK, dimSize_ - off);
                    CopyIn(in, xr + off, cnt);
                    WaitCopyIn();
                    Adds(tmp, in, (T)(-maxv), cnt);
                    Exp(out, tmp, cnt);
                    Muls(tmp, out, (T)inv, cnt);
                    BeforeCopyOut();
                    CopyOut(yr + off, tmp, cnt);
                    AfterCopyOut();
                }
            }
        }
    }

    __aicore__ inline void ProcessStrided() {
        LocalMemAllocator<Hardware::UB> allocator;
        allocator.Init();
        LocalTensor<T> in = allocator.Alloc<T>(CHUNK);
        LocalTensor<T> tmp = allocator.Alloc<T>(CHUNK);
        LocalTensor<T> out = allocator.Alloc<T>(CHUNK);

        uint32_t block = (uint32_t)GetBlockIdx();
        uint64_t rows = (uint64_t)outer_ * (uint64_t)inner_;
        for (uint64_t r = (uint64_t)block; r < rows; r += (uint64_t)numBlocks_) {
            uint32_t o = (uint32_t)(r / (uint64_t)inner_);
            uint32_t j = (uint32_t)(r % (uint64_t)inner_);
            __gm__ T* xr = xGm_ + (uint64_t)o * (uint64_t)dimSize_ * (uint64_t)inner_ + (uint64_t)j;
            __gm__ T* yr = yGm_ + (uint64_t)o * (uint64_t)dimSize_ * (uint64_t)inner_ + (uint64_t)j;

            float maxv = -3.402823466e38f;
            for (uint32_t d = 0; d < dimSize_; ++d) {
                float v = (float)xr[(uint64_t)d * (uint64_t)inner_];
                if (v > maxv) maxv = v;
            }

            float sum = 0.0f;
            for (uint32_t off = 0; off < dimSize_; off += CHUNK) {
                uint32_t cnt = MinU32(CHUNK, dimSize_ - off);
                for (uint32_t i = 0; i < cnt; ++i) {
                    in.SetValue(i, xr[(uint64_t)(off + i) * (uint64_t)inner_]);
                }
                SyncAll();
                Adds(tmp, in, (T)(-maxv), cnt);
                Exp(out, tmp, cnt);
                SyncAll();
                for (uint32_t i = 0; i < cnt; ++i) {
                    sum += (float)out.GetValue(i);
                }
                SyncAll();
            }

            float inv = 1.0f / sum;
            for (uint32_t off = 0; off < dimSize_; off += CHUNK) {
                uint32_t cnt = MinU32(CHUNK, dimSize_ - off);
                for (uint32_t i = 0; i < cnt; ++i) {
                    in.SetValue(i, xr[(uint64_t)(off + i) * (uint64_t)inner_]);
                }
                SyncAll();
                Adds(tmp, in, (T)(-maxv), cnt);
                Exp(out, tmp, cnt);
                Muls(tmp, out, (T)inv, cnt);
                SyncAll();
                for (uint32_t i = 0; i < cnt; ++i) {
                    yr[(uint64_t)(off + i) * (uint64_t)inner_] = out.GetValue(i);
                }
                SyncAll();
            }
        }
    }
};

__global__ __vector__ void softmax_entry(
    __gm__ uint8_t* x,
    __gm__ uint8_t* y,
    uint32_t outer,
    uint32_t dimSize,
    uint32_t inner,
    uint32_t dtype,
    uint32_t numBlocks)
{
    AscendC::InitSocState();

    if (dtype == 0) {
        SoftmaxKernel<float> op;
        op.Init(x, y, outer, dimSize, inner, numBlocks);
        op.Process();
    } else if (dtype == 1) {
        SoftmaxKernel<half> op;
        op.Init(x, y, outer, dimSize, inner, numBlocks);
        op.Process();
    } else {
        SoftmaxKernel<bfloat16_t> op;
        op.Init(x, y, outer, dimSize, inner, numBlocks);
        op.Process();
    }

    AscendC::PipeBarrier<PIPE_ALL>();
}

// ==================== ASCEND_HOST_SECTION ====================

#include <torch/library.h>
#include <ATen/ATen.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"

namespace {

int64_t normalize_dim(int64_t dim, int64_t rank) {
    if (dim < 0) dim += rank;
    return dim;
}

at::Tensor run(const at::Tensor& x, int64_t dim) {
    int64_t rank = x.dim();
    int64_t d = normalize_dim(dim, rank);
    TORCH_CHECK(d >= 0 && d < rank, "dim out of range");

    auto y = at::empty_like(x);

    int64_t outer = 1;
    int64_t inner = 1;
    for (int64_t i = 0; i < d; ++i) outer *= x.size(i);
    for (int64_t i = d + 1; i < rank; ++i) inner *= x.size(i);
    int64_t dimSize = x.size(d);

    uint32_t dtype = 0;
    auto st = x.scalar_type();
    if (st == at::kFloat) {
        dtype = 0;
    } else if (st == at::kHalf) {
        dtype = 1;
    } else if (st == at::kBFloat16) {
        dtype = 2;
    } else {
        TORCH_CHECK(false, "unsupported dtype");
    }

    auto aclStream = c10_npu::getCurrentNPUStream().stream(false);
    uint32_t numBlocks = 20;

    softmax_entry_launch(numBlocks, (void*)aclStream,
                         (uint8_t*)x.data_ptr(),
                         (uint8_t*)y.data_ptr(),
                         (uint32_t)outer,
                         (uint32_t)dimSize,
                         (uint32_t)inner,
                         dtype,
                         numBlocks);

    return y;
}

} // namespace

TORCH_LIBRARY(custom_op, m) {
    m.def("run(Tensor x, int dim) -> Tensor");
}

TORCH_LIBRARY_IMPL(custom_op, PrivateUse1, m) {
    m.impl("run", &run);
}
