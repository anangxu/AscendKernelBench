#include "kernel_operator.h"

__global__ __vector__ void gather_kernel(
    __gm__ uint8_t* x,
    __gm__ uint8_t* indexBytes,
    __gm__ uint8_t* y,
    uint32_t numel,
    uint32_t idxGathered,
    uint32_t inner,
    uint32_t inputGathered,
    uint32_t inputInner,
    uint32_t elemSize,
    uint32_t idxElemSize)
{
    AscendC::InitSocState();

    uint32_t nBlocks = AscendC::GetBlockNum();
    uint32_t bIdx = AscendC::GetBlockIdx();
    uint32_t per = (numel + nBlocks - 1) / nBlocks;
    uint32_t start = bIdx * per;
    if (start > numel) start = numel;
    uint32_t end = start + per;
    if (end > numel) end = numel;

    for (uint32_t p = start; p < end; ++p) {
        uint32_t k = (inner <= 1) ? 0u : (p % inner);
        uint32_t t = (inner <= 1) ? p : (p / inner);
        uint32_t j = (idxGathered <= 1) ? 0u : (t % idxGathered);
        uint32_t o = (idxGathered <= 1) ? t : (t / idxGathered);
        (void)j;

        int64_t iv;
        if (idxElemSize == 8) {
            iv = *(__gm__ int64_t*)(indexBytes + (uint64_t)p * 8);
        } else {
            iv = (int64_t)*(__gm__ int32_t*)(indexBytes + (uint64_t)p * 4);
        }

        uint64_t srcPos = ((uint64_t)o * (uint64_t)inputGathered + (uint64_t)iv)
                          * (uint64_t)inputInner + (uint64_t)k;
        uint64_t sBase = srcPos * (uint64_t)elemSize;
        uint64_t dBase = (uint64_t)p * (uint64_t)elemSize;
        for (uint32_t b = 0; b < elemSize; ++b) {
            y[dBase + b] = x[sBase + b];
        }
    }

    AscendC::PipeBarrier<PIPE_ALL>();
}

// ==================== ASCEND_HOST_SECTION ====================

#include <torch/library.h>
#include <ATen/ATen.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"

at::Tensor run(const at::Tensor& x_in, const at::Tensor& index_in, int64_t dim)
{
    at::Tensor x = x_in.contiguous();
    at::Tensor index = index_in.contiguous();

    int64_t nd = x.dim();
    if (dim < 0) dim += nd;

    at::Tensor y = at::empty(index.sizes(), x.options());

    int64_t inputGathered = x.size(dim);
    int64_t idxGathered = index.size(dim);
    int64_t inner = 1;
    int64_t inputInner = 1;
    for (int64_t i = dim + 1; i < nd; ++i) {
        inner *= index.size(i);
        inputInner *= x.size(i);
    }
    int64_t numel = index.numel();
    int64_t elemSize = x.element_size();
    int64_t idxElemSize = index.element_size();

    auto aclStream = c10_npu::getCurrentNPUStream().stream(false);

    uint8_t* xPtr = static_cast<uint8_t*>(x.data_ptr());
    uint8_t* idxPtr = static_cast<uint8_t*>(index.data_ptr());
    uint8_t* yPtr = static_cast<uint8_t*>(y.data_ptr());

    int numBlocks = 20;
    if (numel < 20) {
        numBlocks = (numel < 1) ? 1 : static_cast<int>(numel);
    }

    gather_kernel_launch(numBlocks, (void*)aclStream,
        xPtr, idxPtr, yPtr,
        (uint32_t)numel,
        (uint32_t)idxGathered,
        (uint32_t)inner,
        (uint32_t)inputGathered,
        (uint32_t)inputInner,
        (uint32_t)elemSize,
        (uint32_t)idxElemSize);

    return y;
}

TORCH_LIBRARY(custom_op, m) {
    m.def("run(Tensor x, Tensor index, int dim) -> Tensor");
}

TORCH_LIBRARY_IMPL(custom_op, PrivateUse1, m) {
    m.impl("run", &run);
}
