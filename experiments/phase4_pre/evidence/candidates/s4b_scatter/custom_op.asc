#include "kernel_operator.h"
#include <math.h>
#include <type_traits>
#include <cstdint>

using namespace AscendC;

constexpr uint32_t CHUNK = 1024;

template <typename T>
class RmsNormKernel {
public:
    __aicore__ inline void Init(
        __gm__ uint8_t* x,
        __gm__ uint8_t* gamma,
        __gm__ uint8_t* y,
        uint32_t rows,
        uint32_t D,
        float eps)
    {
        xGm.SetGlobalBuffer((__gm__ T*)x, rows * D);
        gammaGm.SetGlobalBuffer((__gm__ T*)gamma, D);
        yGm.SetGlobalBuffer((__gm__ T*)y, rows * D);
        this->rows = rows;
        this->D = D;
        this->eps = eps;
        this->blockIdx = (uint32_t)GetBlockIdx();
        this->blockNum = (uint32_t)GetBlockNum();
    }

    __aicore__ inline void Process()
    {
        LocalMemAllocator<Hardware::UB> allocator;
        LocalTensor<float> xF = allocator.Alloc<float>(CHUNK);
        LocalTensor<float> gF = allocator.Alloc<float>(CHUNK);
        LocalTensor<float> acc = allocator.Alloc<float>(CHUNK);
        LocalTensor<T> xRaw = allocator.Alloc<T>(CHUNK);
        LocalTensor<T> gRaw = allocator.Alloc<T>(CHUNK);

        for (uint32_t row = blockIdx; row < rows; row += blockNum) {
            uint32_t reduceLen = D < CHUNK ? D : CHUNK;
            uint32_t remaining = D;
            uint32_t offset = 0;
            uint32_t chunkIdx = 0;

            while (remaining > 0) {
                uint32_t len = remaining < CHUNK ? remaining : CHUNK;
                CopyIn(xRaw, xGm, row * D + offset, len);
                SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);

                LoadFloat(xF, xRaw, len);
                if (chunkIdx == 0) {
                    Adds(acc, xF, 0.0f, len);
                } else {
                    Add(acc, acc, xF, len);
                }

                SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);

                offset += len;
                remaining -= len;
                chunkIdx++;
            }

            ReduceAcc(acc, reduceLen);
            SetFlag<HardEvent::V_S>(EVENT_ID0);
            WaitFlag<HardEvent::V_S>(EVENT_ID0);
            float sum = acc.GetValue(0);
            float mean = sum / (float)D;
            float inv = 1.0f / sqrtf(mean + eps);

            remaining = D;
            offset = 0;
            while (remaining > 0) {
                uint32_t len = remaining < CHUNK ? remaining : CHUNK;

                CopyIn(xRaw, xGm, row * D + offset, len);
                CopyIn(gRaw, gammaGm, offset, len);
                SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);

                LoadFloat(xF, xRaw, len);
                LoadFloat(gF, gRaw, len);
                Mul(xF, xF, gF, len);
                Muls(xF, xF, inv, len);
                StoreRaw(xRaw, xF, len);

                SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                CopyOut(yGm, xRaw, row * D + offset, len);
                SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
                WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);

                offset += len;
                remaining -= len;
            }
        }
    }

private:
    __aicore__ inline void CopyIn(
        LocalTensor<T>& dst,
        GlobalTensor<T>& src,
        uint32_t offset,
        uint32_t len)
    {
        DataCopyExtParams params;
        params.blockCount = 1;
        params.blockLen = len * sizeof(T);
        params.srcStride = 0;
        params.dstStride = 0;

        DataCopyPadExtParams<T> pad;
        pad.isPad = false;
        pad.leftPadding = 0;
        pad.rightPadding = 0;
        pad.paddingValue = 0;

        DataCopyPad(dst, src[offset], params, pad);
    }

    __aicore__ inline void CopyOut(
        GlobalTensor<T>& dst,
        LocalTensor<T>& src,
        uint32_t offset,
        uint32_t len)
    {
        DataCopyExtParams params;
        params.blockCount = 1;
        params.blockLen = len * sizeof(T);
        params.srcStride = 0;
        params.dstStride = 0;

        DataCopyPad(dst[offset], src, params);
    }

    __aicore__ inline void LoadFloat(
        LocalTensor<float>& dst,
        LocalTensor<T>& src,
        uint32_t len)
    {
        if constexpr (std::is_same_v<T, float>) {
            Adds(dst, src, 0.0f, len);
        } else if constexpr (std::is_same_v<T, half> || std::is_same_v<T, bfloat16_t>) {
            Cast(dst, src, RoundMode::CAST_NONE, len);
        } else {
            Cast(dst, src, RoundMode::CAST_RINT, len);
        }
    }

    __aicore__ inline void StoreRaw(
        LocalTensor<T>& dst,
        LocalTensor<float>& src,
        uint32_t len)
    {
        if constexpr (std::is_same_v<T, float>) {
            Adds(dst, src, 0.0f, len);
        } else if constexpr (std::is_integral_v<T>) {
            Cast(dst, src, RoundMode::CAST_TRUNC, len);
        } else {
            Cast(dst, src, RoundMode::CAST_RINT, len);
        }
    }

    __aicore__ inline void ReduceAcc(LocalTensor<float>& acc, uint32_t len)
    {
        while (len > 1) {
            uint32_t half = len >> 1;
            if (half > 0) {
                Add(acc, acc, acc[half], half);
            }
            if (len & 1u) {
                Add(acc, acc, acc[len - 1], 1);
            }
            len = half;
        }
    }

    GlobalTensor<T> xGm;
    GlobalTensor<T> gammaGm;
    GlobalTensor<T> yGm;
    uint32_t rows;
    uint32_t D;
    float eps;
    uint32_t blockIdx;
    uint32_t blockNum;
};

__global__ __vector__ void rms_norm_fp32(
    __gm__ uint8_t* x,
    __gm__ uint8_t* gamma,
    __gm__ uint8_t* y,
    uint32_t rows,
    uint32_t D,
    float eps)
{
    InitSocState();
    RmsNormKernel<float> op;
    op.Init(x, gamma, y, rows, D, eps);
    op.Process();
    PipeBarrier<PIPE_ALL>();
}

__global__ __vector__ void rms_norm_fp16(
    __gm__ uint8_t* x,
    __gm__ uint8_t* gamma,
    __gm__ uint8_t* y,
    uint32_t rows,
    uint32_t D,
    float eps)
{
    InitSocState();
    RmsNormKernel<half> op;
    op.Init(x, gamma, y, rows, D, eps);
    op.Process();
    PipeBarrier<PIPE_ALL>();
}

__global__ __vector__ void rms_norm_bf16(
    __gm__ uint8_t* x,
    __gm__ uint8_t* gamma,
    __gm__ uint8_t* y,
    uint32_t rows,
    uint32_t D,
    float eps)
{
    InitSocState();
    RmsNormKernel<bfloat16_t> op;
    op.Init(x, gamma, y, rows, D, eps);
    op.Process();
    PipeBarrier<PIPE_ALL>();
}

__global__ __vector__ void rms_norm_int32(
    __gm__ uint8_t* x,
    __gm__ uint8_t* gamma,
    __gm__ uint8_t* y,
    uint32_t rows,
    uint32_t D,
    float eps)
{
    InitSocState();
    RmsNormKernel<int32_t> op;
    op.Init(x, gamma, y, rows, D, eps);
    op.Process();
    PipeBarrier<PIPE_ALL>();
}

__global__ __vector__ void rms_norm_int64(
    __gm__ uint8_t* x,
    __gm__ uint8_t* gamma,
    __gm__ uint8_t* y,
    uint32_t rows,
    uint32_t D,
    float eps)
{
    InitSocState();
    RmsNormKernel<int64_t> op;
    op.Init(x, gamma, y, rows, D, eps);
    op.Process();
    PipeBarrier<PIPE_ALL>();
}

// ==================== ASCEND_HOST_SECTION ====================

#include <torch/library.h>
#include <ATen/ATen.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"

at::Tensor run(const at::Tensor& x, const at::Tensor& gamma, double eps)
{
    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");
    TORCH_CHECK(gamma.is_contiguous(), "gamma must be contiguous");

    int64_t D64 = x.size(-1);
    int64_t rows64 = x.numel() / D64;
    if (rows64 == 0) {
        return at::empty_like(x);
    }

    uint32_t D = (uint32_t)D64;
    uint32_t rows = (uint32_t)rows64;
    float epsf = (float)eps;
    at::Tensor y = at::empty_like(x);

    void* stream = (void*)c10_npu::getCurrentNPUStream().stream(false);
    uint32_t numBlocks = rows < 40u ? rows : 40u;

    auto dtype = x.scalar_type();
    if (dtype == at::kFloat) {
        rms_norm_fp32_launch(
            numBlocks, stream,
            (uint8_t*)x.data_ptr(),
            (uint8_t*)gamma.data_ptr(),
            (uint8_t*)y.data_ptr(),
            rows, D, epsf);
    } else if (dtype == at::kHalf) {
        rms_norm_fp16_launch(
            numBlocks, stream,
            (uint8_t*)x.data_ptr(),
            (uint8_t*)gamma.data_ptr(),
            (uint8_t*)y.data_ptr(),
            rows, D, epsf);
    } else if (dtype == at::kBFloat16) {
        rms_norm_bf16_launch(
            numBlocks, stream,
            (uint8_t*)x.data_ptr(),
            (uint8_t*)gamma.data_ptr(),
            (uint8_t*)y.data_ptr(),
            rows, D, epsf);
    } else if (dtype == at::kInt) {
        rms_norm_int32_launch(
            numBlocks, stream,
            (uint8_t*)x.data_ptr(),
            (uint8_t*)gamma.data_ptr(),
            (uint8_t*)y.data_ptr(),
            rows, D, epsf);
    } else if (dtype == at::kLong) {
        rms_norm_int64_launch(
            numBlocks, stream,
            (uint8_t*)x.data_ptr(),
            (uint8_t*)gamma.data_ptr(),
            (uint8_t*)y.data_ptr(),
            rows, D, epsf);
    } else {
        TORCH_CHECK(false, "unsupported dtype");
    }

    return y;
}

TORCH_LIBRARY(custom_op, m)
{
    m.def("run(Tensor x, Tensor gamma, float eps) -> Tensor");
}

TORCH_LIBRARY_IMPL(custom_op, PrivateUse1, m)
{
    m.impl("run", &run);
}
