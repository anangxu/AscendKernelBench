#include "kernel_operator.h"
#include <stdint.h>

class GatherKernel {
public:
    __gm__ uint8_t* x_;
    __gm__ uint8_t* index_;
    __gm__ uint8_t* y_;
    uint32_t total_;
    uint32_t rank_;
    uint32_t dim_;
    uint32_t x_elem_size_;
    uint32_t idx_elem_size_;
    uint32_t sh_[8];
    uint32_t xs_[8];
    uint32_t is_[8];

    void Init(
        __gm__ uint8_t* x,
        __gm__ uint8_t* index,
        __gm__ uint8_t* y,
        uint32_t total,
        uint32_t rank,
        uint32_t dim,
        uint32_t x_elem_size,
        uint32_t idx_elem_size,
        uint32_t s0, uint32_t s1, uint32_t s2, uint32_t s3,
        uint32_t s4, uint32_t s5, uint32_t s6, uint32_t s7,
        uint32_t xs0, uint32_t xs1, uint32_t xs2, uint32_t xs3,
        uint32_t xs4, uint32_t xs5, uint32_t xs6, uint32_t xs7,
        uint32_t is0, uint32_t is1, uint32_t is2, uint32_t is3,
        uint32_t is4, uint32_t is5, uint32_t is6, uint32_t is7)
    {
        x_ = x;
        index_ = index;
        y_ = y;
        total_ = total;
        rank_ = rank;
        dim_ = dim;
        x_elem_size_ = x_elem_size;
        idx_elem_size_ = idx_elem_size;
        sh_[0] = s0; sh_[1] = s1; sh_[2] = s2; sh_[3] = s3;
        sh_[4] = s4; sh_[5] = s5; sh_[6] = s6; sh_[7] = s7;
        xs_[0] = xs0; xs_[1] = xs1; xs_[2] = xs2; xs_[3] = xs3;
        xs_[4] = xs4; xs_[5] = xs5; xs_[6] = xs6; xs_[7] = xs7;
        is_[0] = is0; is_[1] = is1; is_[2] = is2; is_[3] = is3;
        is_[4] = is4; is_[5] = is5; is_[6] = is6; is_[7] = is7;
    }

    void Process()
    {
        uint32_t blockIdx = AscendC::GetBlockIdx();
        uint32_t blockNum = AscendC::GetBlockNum();
        if (blockNum == 0) {
            blockNum = 1;
        }
        for (uint32_t i = blockIdx; i < total_; i += blockNum) {
            uint32_t out_stride = 1;
            uint32_t idx_off = 0;
            uint32_t x_off = 0;
            for (int32_t d = (int32_t)rank_ - 1; d >= 0; --d) {
                uint32_t coord = (i / out_stride) % sh_[d];
                idx_off += coord * is_[d];
                if ((uint32_t)d != dim_) {
                    x_off += coord * xs_[d];
                }
                out_stride *= sh_[d];
            }

            int64_t idx_val = 0;
            if (idx_elem_size_ == 8) {
                idx_val = *(__gm__ int64_t*)(index_ + (uint64_t)idx_off * 8);
            } else {
                idx_val = (int64_t)*(__gm__ int32_t*)(index_ + (uint64_t)idx_off * 4);
            }
            uint32_t gather_idx = (uint32_t)idx_val;
            x_off += gather_idx * xs_[dim_];

            uint64_t src_byte = (uint64_t)x_off * x_elem_size_;
            uint64_t dst_byte = (uint64_t)i * x_elem_size_;
            for (uint32_t b = 0; b < x_elem_size_; ++b) {
                y_[dst_byte + b] = x_[src_byte + b];
            }
        }
    }
};

__global__ __vector__ void gather_entry(
    __gm__ uint8_t* x,
    __gm__ uint8_t* index,
    __gm__ uint8_t* y,
    uint32_t total,
    uint32_t rank,
    uint32_t dim,
    uint32_t x_elem_size,
    uint32_t idx_elem_size,
    uint32_t s0, uint32_t s1, uint32_t s2, uint32_t s3,
    uint32_t s4, uint32_t s5, uint32_t s6, uint32_t s7,
    uint32_t xs0, uint32_t xs1, uint32_t xs2, uint32_t xs3,
    uint32_t xs4, uint32_t xs5, uint32_t xs6, uint32_t xs7,
    uint32_t is0, uint32_t is1, uint32_t is2, uint32_t is3,
    uint32_t is4, uint32_t is5, uint32_t is6, uint32_t is7)
{
    AscendC::InitSocState();
    GatherKernel op;
    op.Init(x, index, y, total, rank, dim, x_elem_size, idx_elem_size,
            s0, s1, s2, s3, s4, s5, s6, s7,
            xs0, xs1, xs2, xs3, xs4, xs5, xs6, xs7,
            is0, is1, is2, is3, is4, is5, is6, is7);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ==================== ASCEND_HOST_SECTION ====================

#include <torch/library.h>
#include <ATen/ATen.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"

at::Tensor run(const at::Tensor& x, const at::Tensor& index, int64_t dim)
{
    TORCH_CHECK(x.dim() == index.dim(), "x and index must have same rank");
    int64_t rank = x.dim();
    TORCH_CHECK(rank >= 1 && rank <= 8, "rank must be in [1,8]");
    int64_t d = dim;
    if (d < 0) {
        d += rank;
    }
    TORCH_CHECK(d >= 0 && d < rank, "dim out of range");
    TORCH_CHECK(index.scalar_type() == at::kLong || index.scalar_type() == at::kInt,
                "index must be int32 or int64");

    at::Tensor y = at::empty(index.sizes(), x.options());

    uint32_t sh[8];
    uint32_t xs[8];
    uint32_t is[8];
    for (int i = 0; i < 8; ++i) {
        sh[i] = 1;
        xs[i] = 0;
        is[i] = 0;
    }
    for (int64_t i = 0; i < rank; ++i) {
        sh[i] = (uint32_t)index.size(i);
        xs[i] = (uint32_t)x.stride(i);
        is[i] = (uint32_t)index.stride(i);
    }

    uint32_t total = (uint32_t)index.numel();
    uint32_t x_elem_size = (uint32_t)x.element_size();
    uint32_t idx_elem_size = (uint32_t)index.element_size();

    int32_t numBlocks = 20;
    auto aclStream = c10_npu::getCurrentNPUStream().stream(false);

    gather_entry_launch(
        numBlocks,
        (void*)aclStream,
        (uint8_t*)x.data_ptr(),
        (uint8_t*)index.data_ptr(),
        (uint8_t*)y.data_ptr(),
        total,
        (uint32_t)rank,
        (uint32_t)d,
        x_elem_size,
        idx_elem_size,
        sh[0], sh[1], sh[2], sh[3], sh[4], sh[5], sh[6], sh[7],
        xs[0], xs[1], xs[2], xs[3], xs[4], xs[5], xs[6], xs[7],
        is[0], is[1], is[2], is[3], is[4], is[5], is[6], is[7]);

    return y;
}

TORCH_LIBRARY(custom_op, m)
{
    m.def("run(Tensor x, Tensor index, int dim) -> Tensor", run);
}

TORCH_LIBRARY_IMPL(custom_op, PrivateUse1, m)
{
    m.impl("run", TORCH_FN(run));
}
