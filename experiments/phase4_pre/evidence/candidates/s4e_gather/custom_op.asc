#include "kernel_operator.h"

using namespace AscendC;

template <typename T>
__aicore__ inline void gatherRange(
    __gm__ uint8_t* xp,
    __gm__ uint8_t* ip,
    __gm__ uint8_t* yp,
    uint32_t start,
    uint32_t end,
    uint32_t xNumel,
    uint32_t total,
    uint32_t inner,
    uint32_t idxAxis,
    uint32_t axis)
{
    GlobalTensor<T> xGm;
    GlobalTensor<T> yGm;
    GlobalTensor<int64_t> iGm;
    xGm.SetGlobalBuffer((__gm__ T*)xp, xNumel);
    yGm.SetGlobalBuffer((__gm__ T*)yp, total);
    iGm.SetGlobalBuffer((__gm__ int64_t*)ip, total);

    for (uint32_t p = start; p < end; ++p) {
        uint32_t i = p % inner;
        uint32_t t = p / inner;
        uint32_t o = t / idxAxis;
        int64_t idx = iGm.GetValue(p);
        uint32_t src = o * axis * inner + (uint32_t)idx * inner + i;
        T v = xGm.GetValue(src);
        yGm.SetValue(p, v);
    }
}

__global__ __vector__ void gather_entry(
    __gm__ uint8_t* x,
    __gm__ uint8_t* index,
    __gm__ uint8_t* y,
    uint32_t total,
    uint32_t xNumel,
    uint32_t inner,
    uint32_t idxAxis,
    uint32_t axis,
    uint32_t elemSize)
{
    AscendC::InitSocState();

    uint32_t blockNum = AscendC::GetBlockNum();
    uint32_t blockIdx = AscendC::GetBlockIdx();

    uint32_t per = (total + blockNum - 1) / blockNum;
    uint32_t start = blockIdx * per;
    uint32_t end = start + per;
    if (end > total) {
        end = total;
    }

    if (start < total) {
        if (elemSize == 1) {
            gatherRange<int8_t>(x, index, y, start, end, xNumel, total, inner, idxAxis, axis);
        } else if (elemSize == 2) {
            gatherRange<int16_t>(x, index, y, start, end, xNumel, total, inner, idxAxis, axis);
        } else if (elemSize == 4) {
            gatherRange<int32_t>(x, index, y, start, end, xNumel, total, inner, idxAxis, axis);
        } else {
            gatherRange<int64_t>(x, index, y, start, end, xNumel, total, inner, idxAxis, axis);
        }
    }

    AscendC::PipeBarrier<PIPE_ALL>();
}

// ==================== ASCEND_HOST_SECTION ====================

#include <torch/library.h>
#include <ATen/ATen.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"

at::Tensor gather_run(const at::Tensor& x, const at::Tensor& index, int64_t dim)
{
    int64_t nd = x.dim();
    int64_t d = dim < 0 ? dim + nd : dim;

    int64_t axis = x.size(d);
    int64_t inner = 1;
    for (int64_t k = d + 1; k < nd; ++k) {
        inner *= x.size(k);
    }
    int64_t idxAxis = index.size(d);
    int64_t total = index.numel();
    int64_t xNumel = x.numel();

    at::Tensor y = at::empty(index.sizes(), x.options());
    if (total == 0) {
        return y;
    }

    uint32_t elemSize = (uint32_t)x.element_size();
    void* aclStream = c10_npu::getCurrentNPUStream().stream(false);

    int nb = total < 40 ? (int)total : 40;
    if (nb < 1) {
        nb = 1;
    }

    gather_entry_launch(
        nb,
        aclStream,
        (uint8_t*)x.data_ptr(),
        (uint8_t*)index.data_ptr(),
        (uint8_t*)y.data_ptr(),
        (uint32_t)total,
        (uint32_t)xNumel,
        (uint32_t)inner,
        (uint32_t)idxAxis,
        (uint32_t)axis,
        elemSize);

    return y;
}

TORCH_LIBRARY(custom_op, m) {
    m.def("run(Tensor x, Tensor index, int dim) -> Tensor", &gather_run);
}

TORCH_LIBRARY_IMPL(custom_op, PrivateUse1, m) {
    m.impl("run", &gather_run);
}
