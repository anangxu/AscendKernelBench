#include "kernel_operator.h"

using namespace AscendC;

constexpr uint32_t SWIGLU_TILE = 4096;

template <typename T>
class SwiGluKernel {
public:
    __aicore__ inline SwiGluKernel() {}

    __aicore__ inline void Init(__gm__ uint8_t* x, __gm__ uint8_t* y,
                                uint32_t outer, uint32_t half, uint32_t inner)
    {
        xGm_.SetGlobalBuffer((__gm__ T*)x);
        yGm_.SetGlobalBuffer((__gm__ T*)y);
        half_ = half;
        inner_ = inner;
        seg_ = half_ * inner_;
        total_ = (uint32_t)((uint64_t)outer * seg_);

        uint32_t blockIdx = AscendC::GetBlockIdx();
        uint32_t blockNum = AscendC::GetBlockNum();
        if (blockNum == 0) {
            blockNum = 1;
        }
        start_ = (uint32_t)((uint64_t)total_ * blockIdx / blockNum);
        end_ = (uint32_t)((uint64_t)total_ * (blockIdx + 1) / blockNum);
    }

    __aicore__ inline void Process()
    {
        if (start_ >= end_ || seg_ == 0) {
            return;
        }

        AscendC::LocalMemAllocator<AscendC::Hardware::UB> alloc;
        AscendC::LocalTensor<T> a = alloc.Alloc<T>(SWIGLU_TILE);
        AscendC::LocalTensor<T> b = alloc.Alloc<T>(SWIGLU_TILE);
        AscendC::LocalTensor<T> tmp = alloc.Alloc<T>(SWIGLU_TILE);

        uint32_t p = start_;
        while (p < end_) {
            uint32_t o = p / seg_;
            uint32_t segEnd = (o + 1) * seg_;
            uint32_t remainAll = end_ - p;
            uint32_t remainSeg = segEnd - p;
            uint32_t n = remainAll < remainSeg ? remainAll : remainSeg;
            if (n > SWIGLU_TILE) {
                n = SWIGLU_TILE;
            }

            uint32_t src0 = p + o * seg_;
            uint32_t src1 = src0 + seg_;

            AscendC::DataCopyExtParams inParams{1, (uint32_t)(n * sizeof(T)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, T(0.0f)};
            AscendC::DataCopyPad(a, xGm_[src0], inParams, padParams);
            AscendC::DataCopyPad(b, xGm_[src1], inParams, padParams);

            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

            AscendC::Muls(tmp, a, T(-1.0f), n);
            AscendC::Exp(tmp, tmp, n);
            AscendC::Adds(tmp, tmp, T(1.0f), n);
            AscendC::Div(a, a, tmp, n);
            AscendC::Mul(a, a, b, n);

            AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

            AscendC::DataCopyExtParams outParams{1, (uint32_t)(n * sizeof(T)), 0, 0, 0};
            AscendC::DataCopyPad(yGm_[p], a, outParams);

            AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);

            p += n;
        }
    }

private:
    AscendC::GlobalTensor<T> xGm_;
    AscendC::GlobalTensor<T> yGm_;
    uint32_t half_ = 0;
    uint32_t inner_ = 0;
    uint32_t seg_ = 0;
    uint32_t total_ = 0;
    uint32_t start_ = 0;
    uint32_t end_ = 0;
};

__global__ __vector__ void swiglu_kernel(
    __gm__ uint8_t* x,
    __gm__ uint8_t* y,
    uint32_t outer,
    uint32_t half,
    uint32_t inner,
    uint32_t dtype)
{
    AscendC::InitSocState();

    if (dtype == 0) {
        SwiGluKernel<float> op;
        op.Init(x, y, outer, half, inner);
        op.Process();
    } else if (dtype == 1) {
        SwiGluKernel<half> op;
        op.Init(x, y, outer, half, inner);
        op.Process();
    } else {
        SwiGluKernel<bfloat16_t> op;
        op.Init(x, y, outer, half, inner);
        op.Process();
    }

    AscendC::PipeBarrier<PIPE_ALL>();
}

// ==================== ASCEND_HOST_SECTION ====================

#include <torch/library.h>
#include <ATen/ATen.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"

at::Tensor run(const at::Tensor& x, int64_t dim)
{
    int64_t ndim = x.dim();
    int64_t d = dim;
    if (d < 0) {
        d += ndim;
    }
    TORCH_CHECK(d >= 0 && d < ndim, "invalid dim for swiglu");
    TORCH_CHECK(x.is_contiguous(), "x must be contiguous");

    auto outSizes = x.sizes().vec();
    int64_t full = outSizes[d];
    TORCH_CHECK(full % 2 == 0, "size along dim must be even");
    int64_t half = full / 2;
    outSizes[d] = half;
    at::Tensor y = at::empty(outSizes, x.options());
    if (half == 0 || x.numel() == 0) {
        return y;
    }

    int64_t outer = 1;
    int64_t inner = 1;
    for (int64_t i = 0; i < d; ++i) {
        outer *= x.size(i);
    }
    for (int64_t i = d + 1; i < ndim; ++i) {
        inner *= x.size(i);
    }

    uint32_t dtype = 0;
    if (x.scalar_type() == at::kFloat) {
        dtype = 0;
    } else if (x.scalar_type() == at::kHalf) {
        dtype = 1;
    } else if (x.scalar_type() == at::kBFloat16) {
        dtype = 2;
    } else {
        TORCH_CHECK(false, "unsupported dtype for swiglu");
    }

    auto aclStream = c10_npu::getCurrentNPUStream().stream(false);
    int numBlocks = 20;
    swiglu_kernel_launch(
        numBlocks,
        (void*)aclStream,
        reinterpret_cast<uint8_t*>(x.data_ptr()),
        reinterpret_cast<uint8_t*>(y.data_ptr()),
        (uint32_t)outer,
        (uint32_t)half,
        (uint32_t)inner,
        dtype);

    return y;
}

TORCH_LIBRARY(custom_op, m)
{
    m.def("run(Tensor x, int dim) -> Tensor");
}

TORCH_LIBRARY_IMPL(custom_op, PrivateUse1, m)
{
    m.impl("run", &run);
}
