#include "kernel_operator.h"

using namespace AscendC;

namespace {

constexpr int32_t kTile = 1024;

template <typename T>
struct TypeTag {
    static constexpr int code = -1;
};
template <>
struct TypeTag<float> { static constexpr int code = 0; };
template <>
struct TypeTag<half> { static constexpr int code = 1; };
template <>
struct TypeTag<bfloat16_t> { static constexpr int code = 2; };
template <>
struct TypeTag<int32_t> { static constexpr int code = 3; };

template <typename T>
class RmsNormKernel {
public:
    __aicore__ inline void Init(__gm__ T* x, __gm__ T* gamma, __gm__ T* y,
                                uint32_t M, uint32_t D, float eps) {
        xGm_.SetGlobalBuffer(x, (uint32_t)((uint64_t)M * D));
        gGm_.SetGlobalBuffer(gamma, (uint32_t)D);
        yGm_.SetGlobalBuffer(y, (uint32_t)((uint64_t)M * D));
        M_ = M;
        D_ = D;
        eps_ = eps;
    }

    __aicore__ inline void Process() {
        uint32_t blockIdx = (uint32_t)GetBlockIdx();
        uint32_t blockNum = (uint32_t)GetBlockNum();
        if (blockNum == 0) blockNum = 1;
        uint32_t rowsPer = (M_ + blockNum - 1) / blockNum;
        uint32_t start = blockIdx * rowsPer;
        uint32_t end = start + rowsPer;
        if (start > M_) start = M_;
        if (end > M_) end = M_;

        LocalMemAllocator<Hardware::UB> alloc;
        LocalTensor<T> raw = alloc.Alloc<T>(kTile);
        LocalTensor<T> gRaw = alloc.Alloc<T>(kTile);
        LocalTensor<float> xf = alloc.Alloc<float>(kTile);
        LocalTensor<float> gf = alloc.Alloc<float>(kTile);
        LocalTensor<float> tmp = alloc.Alloc<float>(kTile);
        LocalTensor<float> acc = alloc.Alloc<float>(kTile);
        LocalTensor<float> work = alloc.Alloc<float>(kTile);
        LocalTensor<float> rsum = alloc.Alloc<float>(8);

        float invD = 1.0f / (float)D_;

        for (uint32_t row = start; row < end; ++row) {
            uint32_t L = (D_ < (uint32_t)kTile) ? D_ : (uint32_t)kTile;
            bool first = true;
            for (uint32_t off = 0; off < D_; off += (uint32_t)kTile) {
                uint32_t cnt = D_ - off;
                if (cnt > (uint32_t)kTile) cnt = (uint32_t)kTile;
                int32_t base = (int32_t)((int64_t)row * (int64_t)D_ + (int64_t)off);

                SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
                WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);

                if constexpr (TypeTag<T>::code == 0) {
                    DataCopyPad(xf, xGm_[base], MakeParams(cnt), MakePad());
                } else {
                    DataCopyPad(raw, xGm_[base], MakeParams(cnt), MakePad());
                }
                SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                if constexpr (TypeTag<T>::code != 0) {
                    Cast(xf, raw, RoundMode::CAST_NONE, cnt);
                }
                if (first) {
                    Mul(acc, xf, xf, cnt);
                    first = false;
                } else {
                    Mul(tmp, xf, xf, cnt);
                    Add(acc, acc, tmp, cnt);
                }
            }

            AscendC::ReduceSum<float>(rsum, acc, work, (int32_t)L);
            Muls(rsum, rsum, invD, 8);
            Adds(rsum, rsum, eps_, 8);
            Sqrt(rsum, rsum, 8);
            Reciprocal(rsum, rsum, 8);
            SetFlag<HardEvent::V_S>(EVENT_ID0);
            WaitFlag<HardEvent::V_S>(EVENT_ID0);
            float inv = rsum.GetValue(0);
            SetFlag<HardEvent::S_V>(EVENT_ID0);
            WaitFlag<HardEvent::S_V>(EVENT_ID0);

            for (uint32_t off = 0; off < D_; off += (uint32_t)kTile) {
                uint32_t cnt = D_ - off;
                if (cnt > (uint32_t)kTile) cnt = (uint32_t)kTile;
                int32_t base = (int32_t)((int64_t)row * (int64_t)D_ + (int64_t)off);
                int32_t gbase = (int32_t)off;

                SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
                WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);

                if constexpr (TypeTag<T>::code == 0) {
                    DataCopyPad(xf, xGm_[base], MakeParams(cnt), MakePad());
                    DataCopyPad(gf, gGm_[gbase], MakeParams(cnt), MakePad());
                } else {
                    DataCopyPad(raw, xGm_[base], MakeParams(cnt), MakePad());
                    DataCopyPad(gRaw, gGm_[gbase], MakeParams(cnt), MakePad());
                }
                SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                if constexpr (TypeTag<T>::code != 0) {
                    Cast(xf, raw, RoundMode::CAST_NONE, cnt);
                    Cast(gf, gRaw, RoundMode::CAST_NONE, cnt);
                }
                Mul(xf, xf, gf, cnt);
                Muls(xf, xf, inv, cnt);

                if constexpr (TypeTag<T>::code == 0) {
                    SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
                    WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                    DataCopyPad(yGm_[base], xf, MakeParams(cnt));
                } else if constexpr (TypeTag<T>::code == 3) {
                    Cast(raw, xf, RoundMode::CAST_TRUNC, cnt);
                    SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
                    WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                    DataCopyPad(yGm_[base], raw, MakeParams(cnt));
                } else {
                    Cast(raw, xf, RoundMode::CAST_RINT, cnt);
                    SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
                    WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                    DataCopyPad(yGm_[base], raw, MakeParams(cnt));
                }
            }
        }
    }

private:
    __aicore__ inline DataCopyExtParams MakeParams(uint32_t cnt) {
        DataCopyExtParams p;
        p.blockCount = 1;
        p.blockLen = (uint32_t)(cnt * (uint32_t)sizeof(T));
        p.srcStride = 0;
        p.dstStride = 0;
        return p;
    }

    __aicore__ inline DataCopyPadExtParams<T> MakePad() {
        DataCopyPadExtParams<T> pad;
        pad.isPad = false;
        pad.leftPadding = 0;
        pad.rightPadding = 0;
        pad.paddingValue = (T)0;
        return pad;
    }

    GlobalTensor<T> xGm_;
    GlobalTensor<T> gGm_;
    GlobalTensor<T> yGm_;
    uint32_t M_;
    uint32_t D_;
    float eps_;
};

}  // namespace

__global__ __vector__ void rms_norm_entry(
    __gm__ uint8_t* x, __gm__ uint8_t* gamma, __gm__ uint8_t* y,
    uint32_t M, uint32_t D, float eps, uint32_t dtype)
{
    AscendC::InitSocState();
    if (dtype == 0) {
        RmsNormKernel<float> k;
        k.Init((__gm__ float*)x, (__gm__ float*)gamma, (__gm__ float*)y, M, D, eps);
        k.Process();
    } else if (dtype == 1) {
        RmsNormKernel<half> k;
        k.Init((__gm__ half*)x, (__gm__ half*)gamma, (__gm__ half*)y, M, D, eps);
        k.Process();
    } else if (dtype == 2) {
        RmsNormKernel<bfloat16_t> k;
        k.Init((__gm__ bfloat16_t*)x, (__gm__ bfloat16_t*)gamma, (__gm__ bfloat16_t*)y, M, D, eps);
        k.Process();
    } else {
        RmsNormKernel<int32_t> k;
        k.Init((__gm__ int32_t*)x, (__gm__ int32_t*)gamma, (__gm__ int32_t*)y, M, D, eps);
        k.Process();
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ==================== ASCEND_HOST_SECTION ====================

#include <torch/library.h>
#include <ATen/ATen.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"

at::Tensor run(const at::Tensor& x, const at::Tensor& gamma, double eps) {
    int64_t dim = x.dim();
    int64_t D = x.size(dim - 1);
    int64_t M = x.numel() / D;
    at::Tensor y = at::empty_like(x);

    uint32_t dtype = 0;
    auto st = x.scalar_type();
    if (st == at::kFloat) {
        dtype = 0;
    } else if (st == at::kHalf) {
        dtype = 1;
    } else if (st == at::kBFloat16) {
        dtype = 2;
    } else if (st == at::kInt) {
        dtype = 3;
    } else {
        dtype = 0;
    }

    int numBlocks = (M < 20) ? (int)M : 20;
    if (numBlocks < 1) numBlocks = 1;

    void* aclStream = (void*)c10_npu::getCurrentNPUStream().stream(false);

    rms_norm_entry_launch(numBlocks, aclStream,
                          (uint8_t*)x.data_ptr(),
                          (uint8_t*)gamma.data_ptr(),
                          (uint8_t*)y.data_ptr(),
                          (uint32_t)M, (uint32_t)D, (float)eps, dtype);
    return y;
}

TORCH_LIBRARY(custom_op, m) {
    m.def("run(Tensor x, Tensor gamma, float eps) -> Tensor");
}

TORCH_LIBRARY_IMPL(custom_op, PrivateUse1, m) {
    m.impl("run", &run);
}
