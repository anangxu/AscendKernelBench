#include "kernel_operator.h"

using namespace AscendC;

constexpr uint32_t MAXD = 8;

class GatherOp {
public:
    __aicore__ inline void Init(
        __gm__ uint8_t* x, __gm__ long long* idx, __gm__ uint8_t* y,
        uint32_t total, uint32_t numBlocks, uint32_t ndim, uint32_t dim,
        uint32_t elemSize,
        uint32_t s0, uint32_t s1, uint32_t s2, uint32_t s3,
        uint32_t s4, uint32_t s5, uint32_t s6, uint32_t s7,
        uint32_t t0, uint32_t t1, uint32_t t2, uint32_t t3,
        uint32_t t4, uint32_t t5, uint32_t t6, uint32_t t7)
    {
        x_ = x;
        idx_ = idx;
        y_ = y;
        ndim_ = ndim;
        dim_ = dim;
        elemSize_ = elemSize;

        uint32_t s[MAXD] = {s0, s1, s2, s3, s4, s5, s6, s7};
        uint32_t t[MAXD] = {t0, t1, t2, t3, t4, t5, t6, t7};
        for (uint32_t k = 0; k < MAXD; ++k) {
            shp_[k] = s[k];
            strd_[k] = t[k];
        }

        uint32_t nb = (numBlocks == 0) ? 1 : numBlocks;
        uint32_t bid = (uint32_t)AscendC::GetBlockIdx();
        uint32_t per = (total + nb - 1) / nb;
        uint32_t st = bid * per;
        uint32_t en = st + per;
        if (st > total) st = total;
        if (en > total) en = total;
        start_ = st;
        end_ = en;
    }

    __aicore__ inline void Process()
    {
        if (start_ >= end_) {
            return;
        }
        long long dimStride = (long long)strd_[dim_];
        for (uint32_t i = start_; i < end_; ++i) {
            uint32_t rem = i;
            long long base = 0;
            for (int j = (int)ndim_ - 1; j >= 0; --j) {
                uint32_t sj = shp_[j];
                uint32_t c = (sj == 0) ? 0 : (rem % sj);
                rem = (sj == 0) ? 0 : (rem / sj);
                if ((uint32_t)j != dim_) {
                    base += (long long)c * (long long)strd_[j];
                }
            }
            long long v = (long long)idx_[i];
            long long off = base + v * dimStride;
            __gm__ uint8_t* src = x_ + off * (long long)elemSize_;
            __gm__ uint8_t* dst = y_ + (long long)i * (long long)elemSize_;
            for (uint32_t b = 0; b < elemSize_; ++b) {
                dst[b] = src[b];
            }
        }
    }

private:
    __gm__ uint8_t* x_;
    __gm__ long long* idx_;
    __gm__ uint8_t* y_;
    uint32_t ndim_;
    uint32_t dim_;
    uint32_t elemSize_;
    uint32_t shp_[MAXD];
    uint32_t strd_[MAXD];
    uint32_t start_;
    uint32_t end_;
};

__global__ __vector__ void gather_kernel(
    __gm__ uint8_t* x,
    __gm__ long long* idx,
    __gm__ uint8_t* y,
    uint32_t total,
    uint32_t numBlocks,
    uint32_t ndim,
    uint32_t dim,
    uint32_t elemSize,
    uint32_t s0, uint32_t s1, uint32_t s2, uint32_t s3,
    uint32_t s4, uint32_t s5, uint32_t s6, uint32_t s7,
    uint32_t t0, uint32_t t1, uint32_t t2, uint32_t t3,
    uint32_t t4, uint32_t t5, uint32_t t6, uint32_t t7)
{
    AscendC::InitSocState();

    GatherOp op;
    op.Init(x, idx, y, total, numBlocks, ndim, dim, elemSize,
            s0, s1, s2, s3, s4, s5, s6, s7,
            t0, t1, t2, t3, t4, t5, t6, t7);
    op.Process();

    AscendC::PipeBarrier<PIPE_ALL>();
}

// ==================== ASCEND_HOST_SECTION ====================

#include <torch/library.h>
#include <ATen/ATen.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"

at::Tensor run(const at::Tensor& x_in, const at::Tensor& index_in, int64_t dim_in)
{
    auto x = x_in.contiguous();
    auto index = index_in.contiguous();

    int64_t ndim = index.dim();
    int64_t dim = dim_in < 0 ? (dim_in + ndim) : dim_in;

    auto y = at::empty(index.sizes(), x.options());

    uint32_t shp[8] = {1, 1, 1, 1, 1, 1, 1, 1};
    uint32_t strd[8] = {0, 0, 0, 0, 0, 0, 0, 0};
    int64_t lim = ndim < 8 ? ndim : 8;
    for (int64_t j = 0; j < lim; ++j) {
        shp[j] = (uint32_t)index.size(j);
        strd[j] = (uint32_t)x.stride(j);
    }

    uint32_t total = (uint32_t)index.numel();
    uint32_t elemSize = (uint32_t)x.element_size();

    uint32_t nblk = 20;
    if (total == 0) {
        nblk = 1;
    } else if (total < nblk) {
        nblk = total;
    }

    void* aclStream = c10_npu::getCurrentNPUStream().stream(false);

    gather_kernel_launch(nblk, (void*)aclStream,
        (uint8_t*)x.data_ptr(),
        (long long*)index.data_ptr(),
        (uint8_t*)y.data_ptr(),
        total, nblk, (uint32_t)ndim, (uint32_t)dim, elemSize,
        shp[0], shp[1], shp[2], shp[3], shp[4], shp[5], shp[6], shp[7],
        strd[0], strd[1], strd[2], strd[3], strd[4], strd[5], strd[6], strd[7]);

    return y;
}

TORCH_LIBRARY(custom_op, m)
{
    m.def("run(Tensor x, Tensor index, int dim) -> Tensor");
}

TORCH_LIBRARY_IMPL(custom_op, PrivateUse1, m)
{
    m.impl("run", &run);
}
