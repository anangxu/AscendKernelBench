// Hand-written SwiGLU with the official single-input half split (fp32).
// One input [512, 2048]; for every row, y[r, :] = silu(x[r, :1024]) * x[r, 1024:].
// Independent implementation: the math is written here, not copied from any
// vendor kernel. Structure follows the repository example so the evaluator
// compiles the sections as separate units and loads libcustom_op.so.
#include "kernel_operator.h"

class KernelSwiGLU {
public:
    __aicore__ inline KernelSwiGLU() {}

    __aicore__ inline void Init(__gm__ uint8_t* x, __gm__ uint8_t* z,
                                uint32_t rows, uint32_t half)
    {
        this->rows = rows;
        this->half = half;
        this->blockNum = AscendC::GetBlockNum();
        this->blockIdx = AscendC::GetBlockIdx();
        xGm.SetGlobalBuffer((__gm__ float*)x, (uint64_t)rows * 2 * half);
        zGm.SetGlobalBuffer((__gm__ float*)z, (uint64_t)rows * half);
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
        AscendC::LocalTensor<float> aLocal = ubAllocator.Alloc<float>(this->half);
        AscendC::LocalTensor<float> bLocal = ubAllocator.Alloc<float>(this->half);
        AscendC::LocalTensor<float> negLocal = ubAllocator.Alloc<float>(this->half);
        AscendC::LocalTensor<float> expLocal = ubAllocator.Alloc<float>(this->half);
        AscendC::LocalTensor<float> sigLocal = ubAllocator.Alloc<float>(this->half);
        AscendC::LocalTensor<float> zLocal = ubAllocator.Alloc<float>(this->half);
        AscendC::LocalTensor<float> oneLocal = ubAllocator.Alloc<float>(this->half);

        AscendC::DataCopyExtParams copyParams{1, this->half * (uint32_t)sizeof(float), 0, 0, 0};
        AscendC::DataCopyPadExtParams<float> padParams{false, 0, 0, 0};
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        // Round-robin the rows over the vector cores.
        for (uint32_t row = this->blockIdx; row < this->rows; row += this->blockNum) {
            uint64_t aOffset = (uint64_t)row * 2 * this->half;
            uint64_t bOffset = aOffset + this->half;
            uint64_t zOffset = (uint64_t)row * this->half;

            AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
            AscendC::DataCopyPad(aLocal, xGm[aOffset], copyParams, padParams);
            AscendC::DataCopyPad(bLocal, xGm[bOffset], copyParams, padParams);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

            AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
            // sigmoid(a) = 1 / (1 + exp(-a)); y = a * sigmoid(a) * b.
            AscendC::Muls(negLocal, aLocal, -1.0f, this->half);
            AscendC::Exp(expLocal, negLocal, this->half);
            AscendC::Adds(expLocal, expLocal, 1.0f, this->half);
            AscendC::Duplicate(oneLocal, 1.0f, this->half);
            AscendC::Div(sigLocal, oneLocal, expLocal, this->half);
            AscendC::Mul(zLocal, aLocal, sigLocal, this->half);
            AscendC::Mul(zLocal, zLocal, bLocal, this->half);
            AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
            AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
            AscendC::DataCopyPad(zGm[zOffset], zLocal, copyParams);
            AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        }
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
    }

private:
    AscendC::GlobalTensor<float> xGm;
    AscendC::GlobalTensor<float> zGm;
    uint32_t rows;
    uint32_t half;
    uint32_t blockNum;
    uint32_t blockIdx;
};

__global__ __vector__ void swiglu_custom(__gm__ uint8_t* x, __gm__ uint8_t* z,
                                         uint32_t rows, uint32_t half)
{
    AscendC::InitSocState();
    KernelSwiGLU op;
    op.Init(x, z, rows, half);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ==================== ASCEND_HOST_SECTION ====================

#include <torch/library.h>
#include <ATen/ATen.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"

namespace custom_op_ns {
at::Tensor run(const at::Tensor& x)
{
    auto aclStream = c10_npu::getCurrentNPUStream().stream(false);
    uint32_t half = (uint32_t)(x.size(-1) / 2);
    at::Tensor z = at::empty({x.size(0), (int64_t)half}, x.options());
    uint32_t rows = (uint32_t)x.size(0);
    uint32_t numBlocks = 40;  // vector cores on Ascend 910B4
    if (rows < numBlocks) {
        numBlocks = rows;
    }
    swiglu_custom_launch(numBlocks, (void*)aclStream,
                         (uint8_t*)(x.mutable_data_ptr()),
                         (uint8_t*)(z.mutable_data_ptr()), rows, half);
    return z;
}
} // namespace custom_op_ns

TORCH_LIBRARY(custom_op, m) { m.def("run(Tensor x) -> Tensor"); }

TORCH_LIBRARY_IMPL(custom_op, PrivateUse1, m)
{
    m.impl("run", TORCH_FN(custom_op_ns::run));
}
