// Hand-written RMSNorm for the CANN suite (fp32, last dim, eps 1e-6).
// Independent implementation; only the repository's verified AscendC calls are
// used. The row sum is folded by 32-element chunks plus a short halving tree
// through a GM scratch buffer, then the row scale is applied elementwise.
#include "kernel_operator.h"

class KernelRmsNorm {
public:
    __aicore__ inline KernelRmsNorm() {}

    __aicore__ inline void Init(__gm__ uint8_t* x, __gm__ uint8_t* gamma,
                                __gm__ uint8_t* z, __gm__ uint8_t* scratch,
                                uint32_t rows, uint32_t cols, float eps)
    {
        this->rows = rows; this->cols = cols; this->eps = eps;
        this->blockNum = AscendC::GetBlockNum();
        this->blockIdx = AscendC::GetBlockIdx();
        xGm.SetGlobalBuffer((__gm__ float*)x, (uint64_t)rows * cols);
        gGm.SetGlobalBuffer((__gm__ float*)gamma, cols);
        zGm.SetGlobalBuffer((__gm__ float*)z, (uint64_t)rows * cols);
        sGm.SetGlobalBuffer((__gm__ float*)scratch, 32);
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ub;
        AscendC::LocalTensor<float> row = ub.Alloc<float>(this->cols);
        AscendC::LocalTensor<float> gam = ub.Alloc<float>(this->cols);
        AscendC::LocalTensor<float> out = ub.Alloc<float>(this->cols);
        AscendC::LocalTensor<float> chunk = ub.Alloc<float>(32);
        AscendC::LocalTensor<float> sq = ub.Alloc<float>(32);
        AscendC::LocalTensor<float> acc = ub.Alloc<float>(32);
        AscendC::LocalTensor<float> lo = ub.Alloc<float>(16);
        AscendC::LocalTensor<float> hi = ub.Alloc<float>(16);
        AscendC::LocalTensor<float> sum16 = ub.Alloc<float>(16);
        AscendC::LocalTensor<float> sum8 = ub.Alloc<float>(8);
        AscendC::LocalTensor<float> sum4 = ub.Alloc<float>(4);
        AscendC::LocalTensor<float> sum2 = ub.Alloc<float>(2);
        AscendC::LocalTensor<float> sum1 = ub.Alloc<float>(1);

        AscendC::DataCopyPadExtParams<float> pad{false, 0, 0, 0};
        AscendC::DataCopyExtParams gParams{1, this->cols * (uint32_t)sizeof(float), 0, 0, 0};
        AscendC::DataCopyExtParams rowParams{1, this->cols * (uint32_t)sizeof(float), 0, 0, 0};
        AscendC::DataCopyExtParams tiny{1, 32 * (uint32_t)sizeof(float), 0, 0, 0};
        AscendC::DataCopyExtParams half{1, 16 * (uint32_t)sizeof(float), 0, 0, 0};
        AscendC::DataCopyExtParams tiny2{1, 8 * (uint32_t)sizeof(float), 0, 0, 0};

        AscendC::DataCopyPad(gam, gGm, gParams, pad);

        for (uint32_t r = this->blockIdx; r < this->rows; r += this->blockNum) {
            uint64_t base = (uint64_t)r * this->cols;
            AscendC::DataCopyPad(row, xGm[base], rowParams, pad);
            // 32 chunks of 32 elements: acc = sum of squares per lane.
            AscendC::Duplicate(acc, 0.0f, 32);
            for (uint32_t c = 0; c < 32; c++) {
                AscendC::DataCopyExtParams cp{1, 32 * (uint32_t)sizeof(float), 0, 0, 0};
                AscendC::DataCopyPad(chunk, xGm[base + c * 32], cp, pad);
                AscendC::Mul(sq, chunk, chunk, 32);
                AscendC::Add(acc, acc, sq, 32);
            }
            // Halving tree through GM: 32 -> 16 -> 8 -> 4 -> 2 -> 1.
            AscendC::DataCopyPad(sGm, acc, tiny);
            AscendC::DataCopyPad(lo, sGm, half, pad);
            AscendC::DataCopyPad(hi, sGm[16], half, pad);
            AscendC::Add(sum16, lo, hi, 16);
            AscendC::DataCopyPad(sGm, sum16, half);
            AscendC::DataCopyPad(lo, sGm, tiny2, pad);
            AscendC::DataCopyPad(hi, sGm[8], tiny2, pad);
            AscendC::Add(sum8, lo, hi, 8);
            AscendC::Add(sum4, sum8, sum8[4], 4);
            AscendC::Add(sum2, sum4, sum4[2], 2);
            AscendC::Add(sum1, sum2, sum2[1], 1);
            // LocalTensor::GetValue is a member; the V pipe must be complete
            // before the scalar read, and the scalar then feeds Muls.
            AscendC::PipeBarrier<PIPE_V>();
            float total = sum1.GetValue(0);
            int32_t cols_i = (int32_t)this->cols;
            float mean = total / (float)cols_i;
            float scale = 1.0f / sqrtf(mean + this->eps);
            AscendC::Muls(out, row, scale, this->cols);
            AscendC::Mul(out, out, gam, this->cols);
            AscendC::DataCopyPad(zGm[base], out, rowParams);
        }
        AscendC::PipeBarrier<PIPE_ALL>();
    }

private:
    AscendC::GlobalTensor<float> xGm, gGm, zGm, sGm;
    uint32_t rows, cols, blockNum, blockIdx;
    float eps;
};

__global__ __vector__ void rmsnorm_custom(__gm__ uint8_t* x, __gm__ uint8_t* gamma,
                                          __gm__ uint8_t* z, __gm__ uint8_t* scratch,
                                          uint32_t rows, uint32_t cols, float eps)
{
    AscendC::InitSocState();
    KernelRmsNorm op;
    op.Init(x, gamma, z, scratch, rows, cols, eps);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ==================== ASCEND_HOST_SECTION ====================

#include <torch/library.h>
#include <ATen/ATen.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"

namespace custom_op_ns {
at::Tensor run(const at::Tensor& x, const at::Tensor& gamma)
{
    auto aclStream = c10_npu::getCurrentNPUStream().stream(false);
    at::Tensor z = at::empty_like(x);
    at::Tensor scratch = at::empty({32}, x.options());
    uint32_t rows = (uint32_t)x.size(0);
    uint32_t cols = (uint32_t)x.size(1);
    uint32_t numBlocks = 40;
    if (rows < numBlocks) {
        numBlocks = rows;
    }
    rmsnorm_custom_launch(numBlocks, (void*)aclStream,
                          (uint8_t*)(x.mutable_data_ptr()),
                          (uint8_t*)(gamma.mutable_data_ptr()),
                          (uint8_t*)(z.mutable_data_ptr()),
                          (uint8_t*)(scratch.mutable_data_ptr()),
                          rows, cols, 1e-6f);
    return z;
}
} // namespace custom_op_ns

TORCH_LIBRARY(custom_op, m) { m.def("run(Tensor x, Tensor gamma) -> Tensor"); }

TORCH_LIBRARY_IMPL(custom_op, PrivateUse1, m)
{
    m.impl("run", TORCH_FN(custom_op_ns::run));
}
